# Central non-secret configuration for local, staging, and production Compose
# runs. This is the only committed runtime template for non-secret environment
# variables. Keep passwords, tokens, API keys, salts, credentials, and
# encryption material in secrets/.env.secrets only. Do not add .env.local,
# .env.production, shell exports, or ad-hoc config files for runtime settings.
# See docs/CONFIGURATION_AND_SECRETS.md.

COMPOSE_PROJECT_NAME=tijara-suite
TIJARA_ENV=development
TIJARA_PUBLIC_URL=http://localhost:8069

ODOO_IMAGE=odoo:19.0
POSTGRES_IMAGE=postgres:16-alpine

POSTGRES_DB=postgres
POSTGRES_USER=odoo

ODOO_DB_HOST=db
ODOO_DB_PORT=5432
ODOO_DB_USER=odoo

ODOO_PROXY_MODE=True
ODOO_WITHOUT_DEMO=True
ODOO_WORKERS=0
ODOO_LIMIT_TIME_CPU=120
ODOO_LIMIT_TIME_REAL=240
ODOO_LOG_LEVEL=info
ODOO_DB_FILTER=.*
ODOO_LIST_DB=True

HTTP_PORT=8069
LONGPOLLING_PORT=8072

TIJARA_BRIDGE_HOST=0.0.0.0
TIJARA_BRIDGE_PORT=9109
TIJARA_BRIDGE_DRY_RUN=True
TIJARA_BRIDGE_DEVICE_CONFIG=/etc/tijara-bridge/devices.json
TIJARA_BRIDGE_JOB_DIR=/var/lib/tijara-bridge/jobs
TIJARA_BRIDGE_OUTPUT_DIR=/var/lib/tijara-bridge/output
TIJARA_BRIDGE_TIMEOUT_SECONDS=5
TIJARA_BRIDGE_REQUIRE_KNOWN_DEVICE=False

TIJARA_SAAS_ENFORCEMENT_ENABLED=False
TIJARA_PAYMENT_REQUIRE_NATIVE_SIGNATURES=False

FBR_ADAPTER_MODE=dry_run
FBR_ADAPTER_ENDPOINT=
FBR_ALLOW_INSECURE_ENDPOINT=False

# Optional monitoring profile
PROMETHEUS_IMAGE=prom/prometheus:v2.54.1
PROMETHEUS_PORT=9090
BLACKBOX_IMAGE=prom/blackbox-exporter:v0.25.0
BLACKBOX_PORT=9115
ALERTMANAGER_IMAGE=prom/alertmanager:v0.27.0
ALERTMANAGER_PORT=9093
PUSHGATEWAY_IMAGE=prom/pushgateway:v1.9.0
PUSHGATEWAY_PORT=9091
LOKI_IMAGE=grafana/loki:3.2.0
LOKI_PORT=3100
GRAFANA_IMAGE=grafana/grafana:11.2.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin

# Optional staging monitoring drill endpoints
TIJARA_STAGING_BASE_URL=http://localhost:8069
TIJARA_HARDWARE_BRIDGE_URL=http://localhost:9109
TIJARA_PROMETHEUS_URL=http://localhost:9090
TIJARA_ALERTMANAGER_URL=http://localhost:9093
TIJARA_PUSHGATEWAY_URL=http://localhost:9091
TIJARA_GRAFANA_URL=http://localhost:3000
TIJARA_BACKUP_DRILL_FILE=

# Demo metrics and Grafana evidence
TIJARA_DEMO_METRICS_ENVIRONMENT=staging-demo
TIJARA_DEMO_METRICS_FILE=deploy/monitoring/tijara-delivery-metrics.example.prom
TIJARA_DEMO_METRICS_JOB=tijara-demo-business
TIJARA_DEMO_METRICS_TIMEOUT=8
TIJARA_OPS_BUNDLE_GRAFANA_DASHBOARD_METADATA_ONLY=False
TIJARA_OPS_BUNDLE_GRAFANA_DASHBOARD_TIMEOUT=15000

# Production DNS/TLS/backup automation wrappers. Keep real API tokens in
# secrets/.env.secrets and pass provider CLI templates only after review.
TIJARA_PRODUCTION_INFRA_ENVIRONMENT=production
TIJARA_PRODUCTION_INFRA_MODE=plan
TIJARA_PRODUCTION_INFRA_EXECUTE=False
TIJARA_PRODUCTION_INFRA_MINIMUM_TENANTS=1
TIJARA_PRODUCTION_INFRA_TENANT_ARTIFACTS=
TIJARA_DNS_APPLY_COMMAND_TEMPLATE=
TIJARA_DNS_ROLLBACK_COMMAND_TEMPLATE=
TIJARA_TLS_APPLY_COMMAND_TEMPLATE=
TIJARA_TLS_ROLLBACK_COMMAND_TEMPLATE=
TIJARA_BACKUP_COMMAND_TEMPLATE=
TIJARA_RESTORE_DRILL_COMMAND_TEMPLATE=
