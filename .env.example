# Central non-secret configuration for local, staging, and production Compose
# runs. This is the only committed runtime template for non-secret environment
# variables. Keep passwords, tokens, API keys, salts, credentials, and
# encryption material in secrets/.env.secrets only. Do not add .env.local,
# .env.production, shell exports, or ad-hoc config files for runtime settings.
# See docs/CONFIGURATION_AND_SECRETS.md.

COMPOSE_PROJECT_NAME=tijara-suite
TIJARA_ENV=development
TIJARA_PUBLIC_URL=http://localhost:8069

ODOO_IMAGE=odoo:19.0
POSTGRES_IMAGE=postgres:16-alpine

POSTGRES_DB=postgres
POSTGRES_USER=odoo

ODOO_DB_HOST=db
ODOO_DB_PORT=5432
ODOO_DB_USER=odoo

ODOO_PROXY_MODE=True
ODOO_WITHOUT_DEMO=True
ODOO_WORKERS=0
ODOO_LIMIT_TIME_CPU=120
ODOO_LIMIT_TIME_REAL=240
ODOO_LOG_LEVEL=info
ODOO_DB_FILTER=.*
ODOO_LIST_DB=True

HTTP_PORT=8069
LONGPOLLING_PORT=8072

TIJARA_BRIDGE_HOST=0.0.0.0
TIJARA_BRIDGE_PORT=9109
TIJARA_BRIDGE_DRY_RUN=True
TIJARA_BRIDGE_DEVICE_CONFIG=/etc/tijara-bridge/devices.json
TIJARA_BRIDGE_JOB_DIR=/var/lib/tijara-bridge/jobs
TIJARA_BRIDGE_OUTPUT_DIR=/var/lib/tijara-bridge/output
TIJARA_BRIDGE_TIMEOUT_SECONDS=5
TIJARA_BRIDGE_REQUIRE_KNOWN_DEVICE=False

TIJARA_SAAS_ENFORCEMENT_ENABLED=False
TIJARA_PAYMENT_REQUIRE_NATIVE_SIGNATURES=False

FBR_ADAPTER_MODE=dry_run
FBR_ADAPTER_ENDPOINT=
FBR_ALLOW_INSECURE_ENDPOINT=False

# Optional monitoring profile
PROMETHEUS_IMAGE=prom/prometheus:v2.54.1
PROMETHEUS_PORT=9090
BLACKBOX_IMAGE=prom/blackbox-exporter:v0.25.0
BLACKBOX_PORT=9115
ALERTMANAGER_IMAGE=prom/alertmanager:v0.27.0
ALERTMANAGER_PORT=9093
PUSHGATEWAY_IMAGE=prom/pushgateway:v1.9.0
PUSHGATEWAY_PORT=9091
LOKI_IMAGE=grafana/loki:3.2.0
LOKI_PORT=3100
GRAFANA_IMAGE=grafana/grafana:11.2.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin

# Optional staging monitoring drill endpoints
TIJARA_STAGING_BASE_URL=http://localhost:8069
TIJARA_HARDWARE_BRIDGE_URL=http://localhost:9109
TIJARA_PROMETHEUS_URL=http://localhost:9090
TIJARA_ALERTMANAGER_URL=http://localhost:9093
TIJARA_PUSHGATEWAY_URL=http://localhost:9091
TIJARA_GRAFANA_URL=http://localhost:3000
TIJARA_BACKUP_DRILL_FILE=

# Demo metrics and Grafana evidence
TIJARA_DEMO_METRICS_ENVIRONMENT=staging-demo
TIJARA_DEMO_METRICS_FILE=deploy/monitoring/tijara-delivery-metrics.example.prom
TIJARA_DEMO_METRICS_JOB=tijara-demo-business
TIJARA_DEMO_METRICS_TIMEOUT=8
TIJARA_OPS_BUNDLE_GRAFANA_DASHBOARD_METADATA_ONLY=False
TIJARA_OPS_BUNDLE_GRAFANA_DASHBOARD_TIMEOUT=15000

# Production DNS/TLS/backup automation wrappers. Keep real API tokens in
# secrets/.env.secrets and pass provider CLI templates only after review.
TIJARA_PRODUCTION_INFRA_ENVIRONMENT=production
TIJARA_PRODUCTION_INFRA_MODE=plan
TIJARA_PRODUCTION_INFRA_EXECUTE=False
TIJARA_PRODUCTION_INFRA_MINIMUM_TENANTS=1
TIJARA_PRODUCTION_INFRA_TENANT_ARTIFACTS=
TIJARA_PRODUCTION_INFRA_TEMPLATE=
TIJARA_PRODUCTION_INFRA_TEMPLATE_FILE=
TIJARA_DNS_APPLY_COMMAND_TEMPLATE=
TIJARA_DNS_ROLLBACK_COMMAND_TEMPLATE=
TIJARA_TLS_APPLY_COMMAND_TEMPLATE=
TIJARA_TLS_ROLLBACK_COMMAND_TEMPLATE=
TIJARA_BACKUP_COMMAND_TEMPLATE=
TIJARA_RESTORE_DRILL_COMMAND_TEMPLATE=
CONFIRM_PROVIDER_ACTION=NO
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_RECORD_ID=
ROUTE53_HOSTED_ZONE_ID=
ROUTE53_PREVIOUS_TARGET=

# Infrastructure provider readiness evidence
TIJARA_INFRA_PROVIDER_READINESS_PROVIDERS=cloudflare,route53,cert-manager,postgres
TIJARA_INFRA_PROVIDER_READINESS_PRODUCTION_INFRA_EVIDENCE=
TIJARA_INFRA_PROVIDER_READINESS_DEPLOYMENT_DECISION=
TIJARA_INFRA_PROVIDER_READINESS_ROLLBACK_DECISION=
TIJARA_INFRA_PROVIDER_READINESS_ALLOW_ASSUMPTIONS=False
TIJARA_INFRA_PROVIDER_READINESS_ASSUME_PROVIDERS=
TIJARA_INFRA_PROVIDER_READINESS_REQUIRE_CREDENTIALS=False
TIJARA_INFRA_PROVIDER_READINESS_REQUIRE_TOOLS=False
TIJARA_INFRA_PROVIDER_READINESS_REQUIRE_REAL_APPROVALS=False
TIJARA_PROD_OPS_PRODUCTION_INFRA_EVIDENCE=
TIJARA_PROD_OPS_INFRA_PROVIDER_READINESS_EVIDENCE=
TIJARA_PROD_OPS_REQUIRE_PRODUCTION_INFRA=True
TIJARA_PROD_OPS_REQUIRE_INFRA_PROVIDER_READINESS=True

# One-command protected release evidence chain. Production should keep
# assumptions disabled and require real provider credentials, tools, and
# deployment/rollback approval evidence from the protected runner.
TIJARA_PROTECTED_CHAIN_STRICT=True
TIJARA_PROTECTED_CHAIN_FAIL_ON_WARNING=True
TIJARA_PROTECTED_CHAIN_ALLOW_ASSUMPTIONS=False
TIJARA_PROTECTED_CHAIN_ASSUME_PROVIDERS=
TIJARA_PROTECTED_CHAIN_PROVIDER_TEMPLATES=cloudflare-dns,route53-dns,cert-manager-kubernetes-tls,postgres-backup-restore
TIJARA_PROTECTED_CHAIN_INFRA_PROVIDERS=cloudflare,route53,cert-manager,postgres
TIJARA_PROTECTED_CHAIN_REQUIRE_PROVIDER_CREDENTIALS=True
TIJARA_PROTECTED_CHAIN_REQUIRE_TOOLS=True
TIJARA_PROTECTED_CHAIN_REQUIRE_REAL_APPROVALS=True
TIJARA_PROTECTED_CHAIN_RUN_DEPLOYMENT_GATE=False
TIJARA_PROTECTED_CHAIN_RUN_ROLLBACK_DRILL=False
TIJARA_PROTECTED_CHAIN_INFRA_MODE=plan
TIJARA_PROTECTED_CHAIN_EXECUTE_INFRA=False
TIJARA_PROTECTED_CHAIN_SIGNOFF_REQUIRED_GROUPS=ops
TIJARA_PROTECTED_CHAIN_EXTRA_EVIDENCE_PATHS=
TIJARA_PROTECTED_CHAIN_METADATA=
TIJARA_PROTECTED_CHAIN_ARTIFACT_NAME=

# Protected POS checkout/refund/print/offline replay matrix. Protected
# staging/production should keep strict and fail-on-warning enabled so the
# release cannot pass without authenticated POS proof and browser matrix data.
TIJARA_E2E_SCOPE=full
TIJARA_RUN_POS_UI_E2E=True
TIJARA_RUN_DIRECT_POS_CLICKTHROUGH=True
TIJARA_RUN_DIRECT_POS_VALIDATE_E2E=True
TIJARA_RUN_DIRECT_REFUND_FORM_E2E=True
TIJARA_RUN_MOBILE_OFFLINE_E2E=True
TIJARA_PROTECTED_E2E_MATRIX=True
TIJARA_PROTECTED_POS_MATRIX_REQUIRED_WORKFLOWS=checkout,refund,print,offline-replay
TIJARA_PROTECTED_POS_MATRIX_REQUIRE_BROWSER_MATRIX=True
TIJARA_PROTECTED_POS_MATRIX_STRICT=True
TIJARA_PROTECTED_POS_MATRIX_FAIL_ON_WARNING=True
TIJARA_PROTECTED_POS_MATRIX_ALLOW_LOCAL=False
