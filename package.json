{
  "name": "tijara-suite",
  "version": "0.17.0",
  "private": true,
  "license": "LGPL-3.0-or-later",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:staging": "bash scripts/run_staging_e2e.sh",
    "ops:staging": "bash scripts/run_staging_ops_checks.sh",
    "release:candidate": "bash scripts/run_release_candidate_gate.sh",
    "signoff:pack": "python3 scripts/generate_signoff_pack.py",
    "release:readiness": "python3 scripts/check_release_readiness.py",
    "release:staging-signoff": "bash scripts/run_staging_release_signoff.sh",
    "release:deployment-gate": "python3 scripts/run_production_deployment_gate.py",
    "release:rollback": "python3 scripts/run_production_rollback.py",
    "release:smoke": "python3 scripts/run_production_smoke.py",
    "certification:evidence": "python3 scripts/collect_certification_evidence.py",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0"
  }
}
