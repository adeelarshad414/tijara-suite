<odoo>
    <record id="action_tijara_ecommerce_delivery_retry" model="ir.actions.act_window">
        <field name="name">Delivery Retry Queue</field>
        <field name="res_model">tijara.ecommerce.delivery.retry</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <record id="view_tijara_ecommerce_delivery_retry_list" model="ir.ui.view">
        <field name="name">tijara.ecommerce.delivery.retry.list</field>
        <field name="model">tijara.ecommerce.delivery.retry</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'" decoration-danger="state == 'failed'" decoration-warning="state in ('pending', 'running')">
                <field name="priority"/>
                <field name="next_attempt_at"/>
                <field name="name"/>
                <field name="provider_id"/>
                <field name="sale_order_id"/>
                <field name="operation"/>
                <field name="state"/>
                <field name="attempt_count"/>
                <field name="max_attempts"/>
                <field name="endpoint_snapshot"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_tijara_ecommerce_delivery_retry_form" model="ir.ui.view">
        <field name="name">tijara.ecommerce.delivery.retry.form</field>
        <field name="model">tijara.ecommerce.delivery.retry</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_run_now" type="object" string="Run Now" class="btn-primary"/>
                    <button name="action_reset" type="object" string="Reset"/>
                    <button name="action_cancel" type="object" string="Cancel"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="provider_id"/>
                            <field name="sale_order_id"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="operation"/>
                            <field name="priority"/>
                            <field name="attempt_count"/>
                            <field name="max_attempts"/>
                            <field name="next_attempt_at"/>
                            <field name="last_attempt_at"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="api_base_url_snapshot"/>
                            <field name="endpoint_snapshot"/>
                            <field name="payload_hash"/>
                            <field name="last_event_id"/>
                        </group>
                        <group>
                            <field name="error_message"/>
                            <field name="notes"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload">
                            <field name="payload_json"/>
                        </page>
                        <page string="Last Response">
                            <field name="last_response_json"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tijara_ecommerce_delivery_retry_search" model="ir.ui.view">
        <field name="name">tijara.ecommerce.delivery.retry.search</field>
        <field name="model">tijara.ecommerce.delivery.retry</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="provider_id"/>
                <field name="sale_order_id"/>
                <filter name="pending" string="Pending" domain="[('state', 'in', ['pending', 'running'])]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_provider" string="Provider" context="{'group_by': 'provider_id'}"/>
                    <filter name="group_operation" string="Operation" context="{'group_by': 'operation'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_tijara_ecommerce_delivery_retry_pivot" model="ir.ui.view">
        <field name="name">tijara.ecommerce.delivery.retry.pivot</field>
        <field name="model">tijara.ecommerce.delivery.retry</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="provider_id" type="row"/>
                <field name="operation" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_tijara_ecommerce_delivery_retry_graph" model="ir.ui.view">
        <field name="name">tijara.ecommerce.delivery.retry.graph</field>
        <field name="model">tijara.ecommerce.delivery.retry</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="operation"/>
                <field name="state"/>
            </graph>
        </field>
    </record>

    <menuitem id="menu_tijara_ecommerce_delivery_retry" name="Retry Queue" parent="menu_tijara_ecommerce_delivery_ops" action="action_tijara_ecommerce_delivery_retry" sequence="10"/>
</odoo>
