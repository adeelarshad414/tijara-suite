<odoo>
    <record id="action_tijara_ecommerce_delivery_reconciliation" model="ir.actions.act_window">
        <field name="name">Delivery Reconciliations</field>
        <field name="res_model">tijara.ecommerce.delivery.reconciliation</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>

    <record id="view_tijara_ecommerce_delivery_reconciliation_list" model="ir.ui.view">
        <field name="name">tijara.ecommerce.delivery.reconciliation.list</field>
        <field name="model">tijara.ecommerce.delivery.reconciliation</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'approved'" decoration-warning="state == 'draft'">
                <field name="name"/>
                <field name="provider_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state"/>
                <field name="order_count"/>
                <field name="delivered_count"/>
                <field name="failed_count"/>
                <field name="cod_amount_total"/>
                <field name="provider_fee_total"/>
                <field name="net_receivable"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_tijara_ecommerce_delivery_reconciliation_form" model="ir.ui.view">
        <field name="name">tijara.ecommerce.delivery.reconciliation.form</field>
        <field name="model">tijara.ecommerce.delivery.reconciliation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_lines" type="object" string="Generate Report" class="btn-primary"/>
                    <button name="action_mark_reviewed" type="object" string="Mark Reviewed"/>
                    <button name="action_approve" type="object" string="Approve"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="provider_id"/>
                            <field name="company_id"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <group string="Totals">
                        <group>
                            <field name="order_count"/>
                            <field name="delivered_count"/>
                            <field name="failed_count"/>
                            <field name="cancelled_count"/>
                            <field name="cod_order_count"/>
                        </group>
                        <group>
                            <field name="amount_total"/>
                            <field name="cod_amount_total"/>
                            <field name="delivery_charge_total"/>
                            <field name="provider_fee_total"/>
                            <field name="net_receivable"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sale_order_id"/>
                                    <field name="order_name"/>
                                    <field name="tracking_number"/>
                                    <field name="delivery_status"/>
                                    <field name="payment_method"/>
                                    <field name="payment_status"/>
                                    <field name="amount_total"/>
                                    <field name="cod_amount"/>
                                    <field name="delivery_charge"/>
                                    <field name="provider_fee"/>
                                    <field name="net_receivable"/>
                                </list>
                            </field>
                        </page>
                        <page string="Report JSON">
                            <field name="report_json"/>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tijara_ecommerce_delivery_reconciliation_search" model="ir.ui.view">
        <field name="name">tijara.ecommerce.delivery.reconciliation.search</field>
        <field name="model">tijara.ecommerce.delivery.reconciliation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="provider_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="reviewed" string="Reviewed" domain="[('state', '=', 'reviewed')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <group>
                    <filter name="group_provider" string="Provider" context="{'group_by': 'provider_id'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_tijara_ecommerce_delivery_reconciliation_pivot" model="ir.ui.view">
        <field name="name">tijara.ecommerce.delivery.reconciliation.pivot</field>
        <field name="model">tijara.ecommerce.delivery.reconciliation</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="provider_id" type="row"/>
                <field name="state" type="col"/>
                <field name="order_count" type="measure"/>
                <field name="cod_amount_total" type="measure"/>
                <field name="net_receivable" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_tijara_ecommerce_delivery_reconciliation_graph" model="ir.ui.view">
        <field name="name">tijara.ecommerce.delivery.reconciliation.graph</field>
        <field name="model">tijara.ecommerce.delivery.reconciliation</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="provider_id"/>
                <field name="net_receivable" type="measure"/>
            </graph>
        </field>
    </record>

    <menuitem id="menu_tijara_ecommerce_delivery_reconciliation" name="Reconciliation" parent="menu_tijara_ecommerce_delivery_ops" action="action_tijara_ecommerce_delivery_reconciliation" sequence="30"/>
</odoo>
