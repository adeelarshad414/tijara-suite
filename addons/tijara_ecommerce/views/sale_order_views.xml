<odoo>
    <record id="action_tijara_ecommerce_sale_order" model="ir.actions.act_window">
        <field name="name">Online Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="domain">[('tijara_ecommerce_channel_id', '!=', False)]</field>
        <field name="context">{'search_default_tijara_ecommerce': 1}</field>
    </record>

    <record id="view_order_form_tijara_ecommerce" model="ir.ui.view">
        <field name="name">sale.order.form.tijara.ecommerce</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_tijara_mark_ecommerce_paid" type="object" string="Mark Ecommerce Paid" invisible="not tijara_ecommerce_channel_id or tijara_payment_status == 'paid'"/>
                <button name="action_tijara_create_ecommerce_queue_ticket" type="object" string="Create Queue Ticket" invisible="not tijara_ecommerce_channel_id or tijara_queue_ticket_id"/>
                <button name="action_tijara_prepare_delivery" type="object" string="Prepare Delivery" invisible="not tijara_ecommerce_channel_id or tijara_fulfillment_method not in ('delivery', 'courier')"/>
                <button name="action_tijara_mark_delivery_picked" type="object" string="Mark Picked" invisible="not tijara_ecommerce_channel_id or tijara_delivery_status not in ('assigned', 'pending')"/>
                <button name="action_tijara_mark_out_for_delivery" type="object" string="Out For Delivery" invisible="not tijara_ecommerce_channel_id or tijara_delivery_status not in ('assigned', 'picked')"/>
                <button name="action_tijara_mark_delivered" type="object" string="Mark Delivered" invisible="not tijara_ecommerce_channel_id or tijara_delivery_status == 'delivered'"/>
            </xpath>
            <xpath expr="//sheet/notebook" position="inside">
                <page name="tijara_ecommerce" string="Tijara Ecommerce" invisible="not tijara_ecommerce_channel_id">
                    <group>
                        <group>
                            <field name="tijara_ecommerce_channel_id"/>
                            <field name="tijara_ecommerce_reference"/>
                            <field name="tijara_ecommerce_audience"/>
                            <field name="tijara_fulfillment_method"/>
                            <field name="tijara_pickup_code"/>
                            <field name="tijara_tracking_url" widget="url"/>
                            <field name="tijara_queue_ticket_id"/>
                        </group>
                        <group>
                            <field name="tijara_payment_method"/>
                            <field name="tijara_payment_status"/>
                            <field name="tijara_amount_service_charge"/>
                            <field name="tijara_amount_delivery_charge"/>
                            <field name="tijara_amount_payment_tax"/>
                            <field name="tijara_estimated_gst"/>
                            <field name="tijara_loyalty_points_awarded"/>
                        </group>
                    </group>
                    <group string="Delivery">
                        <group>
                            <field name="tijara_delivery_mobile"/>
                            <field name="tijara_delivery_address"/>
                            <field name="tijara_delivery_provider_id"/>
                            <field name="tijara_delivery_status"/>
                        </group>
                        <group>
                            <field name="tijara_delivery_tracking_number"/>
                            <field name="tijara_delivery_tracking_url" widget="url"/>
                            <field name="tijara_delivery_eta"/>
                            <field name="tijara_last_tracking_at"/>
                        </group>
                    </group>
                    <group string="Provider Payload">
                        <field name="tijara_delivery_provider_payload"/>
                    </group>
                    <group string="Payload">
                        <field name="tijara_ecommerce_payload"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_tijara_ecommerce_sale_order" name="Online Orders" parent="menu_tijara_ecommerce" action="action_tijara_ecommerce_sale_order" sequence="10"/>
</odoo>
