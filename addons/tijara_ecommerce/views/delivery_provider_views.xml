<odoo>
    <record id="action_tijara_ecommerce_delivery_provider" model="ir.actions.act_window">
        <field name="name">Delivery Providers</field>
        <field name="res_model">tijara.ecommerce.delivery.provider</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_tijara_ecommerce_delivery_provider_list" model="ir.ui.view">
        <field name="name">tijara.ecommerce.delivery.provider.list</field>
        <field name="model">tijara.ecommerce.delivery.provider</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active" decoration-warning="not dry_run">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="provider_type"/>
                <field name="adapter_profile"/>
                <field name="service_level"/>
                <field name="adapter_mode"/>
                <field name="dry_run"/>
                <field name="auto_assign"/>
                <field name="shipment_count"/>
                <field name="event_count"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_tijara_ecommerce_delivery_provider_form" model="ir.ui.view">
        <field name="name">tijara.ecommerce.delivery.provider.form</field>
        <field name="model">tijara.ecommerce.delivery.provider</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_provider" type="object" string="Test Provider" class="btn-primary"/>
                    <button name="action_apply_profile_defaults" type="object" string="Apply Profile Defaults"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_shipments" type="object" class="oe_stat_button" icon="fa-truck">
                            <field name="shipment_count" widget="statinfo" string="Shipments"/>
                        </button>
                        <button name="action_open_events" type="object" class="oe_stat_button" icon="fa-exchange">
                            <field name="event_count" widget="statinfo" string="Events"/>
                        </button>
                        <button name="action_open_retries" type="object" class="oe_stat_button" icon="fa-refresh">
                            <field name="retry_count" widget="statinfo" string="Retries"/>
                        </button>
                        <button name="action_open_exceptions" type="object" class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="exception_count" widget="statinfo" string="Exceptions"/>
                        </button>
                        <button name="action_open_reconciliations" type="object" class="oe_stat_button" icon="fa-calculator">
                            <field name="reconciliation_count" widget="statinfo" string="Reconcile"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="company_id"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="provider_type"/>
                            <field name="adapter_profile"/>
                            <field name="service_level"/>
                            <field name="adapter_mode"/>
                            <field name="dry_run"/>
                            <field name="auto_assign"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Capabilities">
                            <group>
                                <field name="supports_delivery"/>
                                <field name="supports_courier"/>
                                <field name="supports_cod"/>
                                <field name="supports_cancel"/>
                                <field name="supports_labels"/>
                                <field name="supports_manifests"/>
                                <field name="supports_webhooks"/>
                            </group>
                        </page>
                        <page string="Integration">
                            <group>
                                <group string="Endpoints">
                                    <field name="api_base_url"/>
                                    <field name="create_endpoint"/>
                                    <field name="cancel_endpoint"/>
                                    <field name="status_endpoint"/>
                                    <field name="label_endpoint"/>
                                    <field name="manifest_endpoint"/>
                                    <field name="tracking_url_template"/>
                                </group>
                                <group string="Webhook And Output">
                                    <field name="label_format"/>
                                    <field name="webhook_signature_mode"/>
                                    <field name="webhook_signature_header"/>
                                    <field name="webhook_reference_field"/>
                                    <field name="webhook_status_field"/>
                                    <field name="webhook_eta_field"/>
                                    <field name="webhook_secret_ref"/>
                                    <field name="contact_phone"/>
                                </group>
                            </group>
                        </page>
                        <page string="Operations">
                            <group>
                                <group string="Rider And SLA">
                                    <field name="rider_name"/>
                                    <field name="rider_mobile"/>
                                    <field name="sla_hours"/>
                                    <field name="retry_initial_delay_minutes"/>
                                    <field name="retry_backoff_multiplier"/>
                                    <field name="retry_max_attempts"/>
                                </group>
                                <group string="Settlement Assumptions">
                                    <field name="provider_fee_flat"/>
                                    <field name="cod_fee_percent"/>
                                    <field name="settlement_cycle"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tijara_ecommerce_delivery_provider_search" model="ir.ui.view">
        <field name="name">tijara.ecommerce.delivery.provider.search</field>
        <field name="model">tijara.ecommerce.delivery.provider</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="adapter_profile"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="dry_run" string="Dry Run" domain="[('dry_run', '=', True)]"/>
                <filter name="live_mode" string="Live Mode" domain="[('dry_run', '=', False)]"/>
                <filter name="http_json" string="HTTP JSON Adapter" domain="[('adapter_mode', '=', 'http_json')]"/>
                <group>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="group_profile" string="Adapter Profile" context="{'group_by': 'adapter_profile'}"/>
                    <filter name="group_provider_type" string="Provider Type" context="{'group_by': 'provider_type'}"/>
                    <filter name="group_service_level" string="Service Level" context="{'group_by': 'service_level'}"/>
                    <filter name="group_adapter" string="Adapter Mode" context="{'group_by': 'adapter_mode'}"/>
                </group>
            </search>
        </field>
    </record>

    <menuitem id="menu_tijara_ecommerce_delivery_provider" name="Delivery Providers" parent="menu_tijara_ecommerce_configuration" action="action_tijara_ecommerce_delivery_provider" sequence="20"/>
</odoo>
