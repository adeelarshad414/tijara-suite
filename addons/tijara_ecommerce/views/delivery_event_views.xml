<odoo>
    <record id="action_tijara_ecommerce_delivery_event" model="ir.actions.act_window">
        <field name="name">Delivery Adapter Events</field>
        <field name="res_model">tijara.ecommerce.delivery.event</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="context">{'search_default_recent': 1}</field>
    </record>

    <record id="view_tijara_ecommerce_delivery_event_list" model="ir.ui.view">
        <field name="name">tijara.ecommerce.delivery.event.list</field>
        <field name="model">tijara.ecommerce.delivery.event</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'processed'" decoration-danger="status == 'failed'" decoration-warning="status == 'queued'">
                <field name="create_date"/>
                <field name="name"/>
                <field name="provider_id"/>
                <field name="sale_order_id"/>
                <field name="direction"/>
                <field name="event_type"/>
                <field name="status"/>
                <field name="signature_status"/>
                <field name="tracking_number"/>
                <field name="external_reference"/>
                <field name="manifest_reference"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_tijara_ecommerce_delivery_event_form" model="ir.ui.view">
        <field name="name">tijara.ecommerce.delivery.event.form</field>
        <field name="model">tijara.ecommerce.delivery.event</field>
        <field name="arch" type="xml">
            <form create="0">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="provider_id"/>
                            <field name="sale_order_id"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="direction"/>
                            <field name="event_type"/>
                            <field name="status"/>
                            <field name="signature_status"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="tracking_number"/>
                            <field name="external_reference"/>
                            <field name="manifest_reference"/>
                        </group>
                        <group>
                            <field name="payload_hash"/>
                            <field name="message"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload">
                            <field name="payload_json"/>
                        </page>
                        <page string="Response">
                            <field name="response_json"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tijara_ecommerce_delivery_event_search" model="ir.ui.view">
        <field name="name">tijara.ecommerce.delivery.event.search</field>
        <field name="model">tijara.ecommerce.delivery.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="provider_id"/>
                <field name="sale_order_id"/>
                <field name="tracking_number"/>
                <field name="external_reference"/>
                <filter name="recent" string="Recent" domain="[]"/>
                <filter name="processed" string="Processed" domain="[('status', '=', 'processed')]"/>
                <filter name="failed" string="Failed" domain="[('status', '=', 'failed')]"/>
                <filter name="inbound" string="Inbound" domain="[('direction', '=', 'inbound')]"/>
                <filter name="outbound" string="Outbound" domain="[('direction', '=', 'outbound')]"/>
                <group>
                    <filter name="group_provider" string="Provider" context="{'group_by': 'provider_id'}"/>
                    <filter name="group_event_type" string="Event Type" context="{'group_by': 'event_type'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_signature" string="Signature" context="{'group_by': 'signature_status'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_tijara_ecommerce_delivery_event_pivot" model="ir.ui.view">
        <field name="name">tijara.ecommerce.delivery.event.pivot</field>
        <field name="model">tijara.ecommerce.delivery.event</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="provider_id" type="row"/>
                <field name="event_type" type="row"/>
                <field name="status" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_tijara_ecommerce_delivery_event_graph" model="ir.ui.view">
        <field name="name">tijara.ecommerce.delivery.event.graph</field>
        <field name="model">tijara.ecommerce.delivery.event</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="event_type"/>
                <field name="status"/>
            </graph>
        </field>
    </record>

    <menuitem id="menu_tijara_ecommerce_delivery_event" name="Delivery Adapter Events" parent="menu_tijara_ecommerce" action="action_tijara_ecommerce_delivery_event" sequence="30"/>
</odoo>
