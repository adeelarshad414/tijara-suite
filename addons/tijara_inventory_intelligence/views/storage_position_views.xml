<odoo>
    <record id="view_tijara_storage_position_list" model="ir.ui.view">
        <field name="name">tijara.storage.position.list</field>
        <field name="model">tijara.storage.position</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="warehouse_id"/>
                <field name="location_id"/>
                <field name="zone"/>
                <field name="aisle"/>
                <field name="rack"/>
                <field name="shelf"/>
                <field name="bin"/>
                <field name="temperature_zone"/>
                <field name="capacity_qty"/>
                <field name="preferred_min_qty"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_tijara_storage_position_form" model="ir.ui.view">
        <field name="name">tijara.storage.position.form</field>
        <field name="model">tijara.storage.position</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="barcode"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="warehouse_id"/>
                            <field name="location_id"/>
                            <field name="temperature_zone"/>
                        </group>
                    </group>
                    <group string="Physical Placement">
                        <group>
                            <field name="zone"/>
                            <field name="aisle"/>
                            <field name="rack"/>
                        </group>
                        <group>
                            <field name="shelf"/>
                            <field name="bin"/>
                            <field name="capacity_qty"/>
                            <field name="preferred_min_qty"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tijara_storage_position_search" model="ir.ui.view">
        <field name="name">tijara.storage.position.search</field>
        <field name="model">tijara.storage.position</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="barcode"/>
                <field name="warehouse_id"/>
                <field name="location_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="cold_chain" string="Cold Chain" domain="[('temperature_zone', 'in', ['cool', 'cold', 'frozen', 'controlled'])]"/>
                <group>
                    <filter name="group_warehouse" string="Warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter name="group_location" string="Location" context="{'group_by': 'location_id'}"/>
                    <filter name="group_zone" string="Zone" context="{'group_by': 'zone'}"/>
                    <filter name="group_rack" string="Rack" context="{'group_by': 'rack'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tijara_storage_position" model="ir.actions.act_window">
        <field name="name">Storage Positions</field>
        <field name="res_model">tijara.storage.position</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tijara_storage_position_search"/>
    </record>

    <menuitem id="menu_tijara_storage_position" name="Storage Positions" parent="menu_tijara_inventory_intelligence" action="action_tijara_storage_position" sequence="20"/>
</odoo>
