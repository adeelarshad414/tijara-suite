<odoo>
    <record id="view_tijara_analytics_dashboard_list" model="ir.ui.view">
        <field name="name">tijara.analytics.dashboard.list</field>
        <field name="model">tijara.analytics.dashboard</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="name"/>
                <field name="code"/>
                <field name="audience"/>
                <field name="refresh_interval_minutes"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_tijara_analytics_dashboard_form" model="ir.ui.view">
        <field name="name">tijara.analytics.dashboard.form</field>
        <field name="model">tijara.analytics.dashboard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="audience"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="refresh_interval_minutes"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Widgets">
                            <field name="widget_ids">
                                <list editable="bottom">
                                    <field name="sequence"/>
                                    <field name="name"/>
                                    <field name="widget_type"/>
                                    <field name="business_area"/>
                                    <field name="metric_code"/>
                                    <field name="feature_code"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tijara_analytics_widget_list" model="ir.ui.view">
        <field name="name">tijara.analytics.widget.list</field>
        <field name="model">tijara.analytics.widget</field>
        <field name="arch" type="xml">
            <list>
                <field name="dashboard_id"/>
                <field name="sequence"/>
                <field name="name"/>
                <field name="widget_type"/>
                <field name="business_area"/>
                <field name="metric_code"/>
                <field name="feature_code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_tijara_analytics_widget_form" model="ir.ui.view">
        <field name="name">tijara.analytics.widget.form</field>
        <field name="model">tijara.analytics.widget</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="dashboard_id"/>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="widget_type"/>
                            <field name="business_area"/>
                            <field name="metric_code"/>
                            <field name="feature_code"/>
                        </group>
                    </group>
                    <group>
                        <field name="target_note"/>
                        <field name="query_note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tijara_analytics_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboards</field>
        <field name="res_model">tijara.analytics.dashboard</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_tijara_analytics_widget" model="ir.actions.act_window">
        <field name="name">Dashboard Widgets</field>
        <field name="res_model">tijara.analytics.widget</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_tijara_analytics_dashboard" name="Dashboards" parent="menu_tijara_analytics" action="action_tijara_analytics_dashboard" sequence="10"/>
    <menuitem id="menu_tijara_analytics_widget" name="Dashboard Widgets" parent="menu_tijara_analytics_configuration" action="action_tijara_analytics_widget" sequence="10"/>
</odoo>
