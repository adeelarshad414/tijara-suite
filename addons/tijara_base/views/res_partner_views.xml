<odoo>
    <record id="view_partner_form_tijara" model="ir.ui.view">
        <field name="name">res.partner.form.tijara</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="tijara_urdu_name"/>
                <field name="tijara_cnic"/>
                <field name="tijara_ntn"/>
                <field name="tijara_strn"/>
                <field name="tijara_customer_type"/>
                <field name="tijara_is_walk_in"/>
                <field name="tijara_credit_limit"/>
            </xpath>
        </field>
    </record>
</odoo>

