<odoo>
    <template id="tijara_web_login_layout" inherit_id="web.login_layout" priority="60" name="Tijara End User Login Layout">
        <xpath expr="//t[@t-call]" position="replace">
            <t t-call="web.frontend_layout">
                <t t-set="html_data" t-value="{'style': 'height: 100%;'}"/>
                <t t-set="body_classname" t-value="'tijara-login-page'"/>
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>
                <style>
                    :root {
                        --tijara-login-ink: #172033;
                        --tijara-login-muted: #536174;
                        --tijara-login-primary: #1f7a8c;
                        --tijara-login-primary-dark: #155e6f;
                        --tijara-login-border: #dfe6ee;
                        --tijara-login-panel: #ffffff;
                        --tijara-login-soft: #f6f8fb;
                    }
                    body.tijara-login-page {
                        min-height: 100vh;
                        background: linear-gradient(135deg, #f8fafc 0%, #eef7f6 48%, #f9fbfd 100%);
                        color: var(--tijara-login-ink);
                    }
                    .tijara-login-shell {
                        min-height: 100vh;
                        display: grid;
                        grid-template-columns: minmax(0, 1.08fr) minmax(360px, .72fr);
                        gap: 48px;
                        align-items: center;
                        width: min(1120px, calc(100vw - 48px));
                        margin: 0 auto;
                        padding: 48px 0;
                    }
                    .tijara-login-story {
                        max-width: 650px;
                    }
                    .tijara-login-kicker {
                        display: inline-flex;
                        align-items: center;
                        min-height: 34px;
                        border: 1px solid rgba(31, 122, 140, .28);
                        border-radius: 7px;
                        padding: 0 12px;
                        background: rgba(255, 255, 255, .78);
                        color: var(--tijara-login-primary-dark);
                        font-weight: 800;
                        font-size: .86rem;
                    }
                    .tijara-login-story h1 {
                        margin: 18px 0 12px;
                        max-width: 620px;
                        font-size: clamp(2.2rem, 5vw, 4.35rem);
                        line-height: .98;
                        letter-spacing: 0;
                        font-weight: 850;
                    }
                    .tijara-login-story p {
                        margin: 0;
                        max-width: 570px;
                        color: var(--tijara-login-muted);
                        font-size: 1.08rem;
                        line-height: 1.58;
                    }
                    .tijara-login-feature-grid {
                        display: grid;
                        grid-template-columns: repeat(2, minmax(0, 1fr));
                        gap: 12px;
                        margin-top: 28px;
                    }
                    .tijara-login-feature {
                        min-height: 74px;
                        border: 1px solid var(--tijara-login-border);
                        border-radius: 8px;
                        padding: 14px;
                        background: rgba(255, 255, 255, .82);
                    }
                    .tijara-login-feature strong {
                        display: block;
                        margin-bottom: 4px;
                        color: var(--tijara-login-ink);
                        font-size: .98rem;
                    }
                    .tijara-login-feature span {
                        display: block;
                        color: var(--tijara-login-muted);
                        font-size: .86rem;
                        line-height: 1.35;
                    }
                    .tijara-login-card {
                        border: 1px solid var(--tijara-login-border);
                        border-radius: 8px;
                        background: var(--tijara-login-panel);
                        box-shadow: 0 24px 70px rgba(15, 23, 42, .14);
                        overflow: hidden;
                    }
                    .tijara-login-card-header {
                        display: grid;
                        gap: 12px;
                        padding: 30px 30px 18px;
                        text-align: center;
                        border-bottom: 1px solid #eef2f7;
                        background: linear-gradient(180deg, #fff, #fbfcfe);
                    }
                    .tijara-login-card-header img {
                        display: block;
                        max-width: 170px;
                        max-height: 92px;
                        width: auto;
                        height: auto;
                        margin: 0 auto;
                    }
                    .tijara-login-card-header h2 {
                        margin: 0;
                        font-size: 1.38rem;
                        letter-spacing: 0;
                        font-weight: 850;
                    }
                    .tijara-login-card-header p {
                        margin: 0;
                        color: var(--tijara-login-muted);
                        font-size: .92rem;
                        line-height: 1.42;
                    }
                    .tijara-login-card-body {
                        padding: 26px 30px 30px;
                    }
                    .tijara-login-card-body .form-control {
                        min-height: 46px;
                        border-radius: 7px;
                        border-color: #d8e1ea;
                    }
                    .tijara-login-card-body .form-label {
                        font-weight: 750;
                        color: #273449;
                    }
                    .tijara-login-card-body .btn-primary {
                        min-height: 48px;
                        border: 0;
                        border-radius: 7px;
                        background: var(--tijara-login-primary);
                        font-weight: 850;
                    }
                    .tijara-login-card-body .btn-primary:hover,
                    .tijara-login-card-body .btn-primary:focus {
                        background: var(--tijara-login-primary-dark);
                    }
                    .tijara-login-card-body a[href*="/web/database"],
                    .tijara-login-card-body a[href*="/web/signup"],
                    .tijara-login-card-body a[href*="/web/reset_password"],
                    .tijara-login-card-body .o_brand_promotion,
                    .tijara-login-card-body .o_login_auth {
                        display: none !important;
                    }
                    .tijara-login-card-note {
                        margin: 18px 30px 28px;
                        border: 1px solid #e3eaf2;
                        border-radius: 8px;
                        padding: 12px 14px;
                        background: var(--tijara-login-soft);
                        color: #526176;
                        font-size: .84rem;
                        line-height: 1.42;
                        text-align: center;
                    }
                    @media (max-width: 860px) {
                        .tijara-login-shell {
                            grid-template-columns: 1fr;
                            gap: 24px;
                            width: min(560px, calc(100vw - 28px));
                            padding: 24px 0;
                        }
                        .tijara-login-card {
                            order: 1;
                        }
                        .tijara-login-story {
                            order: 2;
                        }
                        .tijara-login-story h1 {
                            font-size: 2rem;
                            line-height: 1.08;
                        }
                        .tijara-login-story p {
                            font-size: .98rem;
                        }
                        .tijara-login-feature-grid {
                            grid-template-columns: 1fr;
                            margin-top: 18px;
                        }
                        .tijara-login-card-header,
                        .tijara-login-card-body {
                            padding-left: 22px;
                            padding-right: 22px;
                        }
                        .tijara-login-card-note {
                            margin-left: 22px;
                            margin-right: 22px;
                        }
                    }
                </style>
                <div class="tijara-login-shell" role="main" aria-label="Tijara Suite sign in">
                    <section class="tijara-login-story">
                        <div class="tijara-login-kicker">Pakistan-ready business suite</div>
                        <h1>Run your store, restaurant, inventory, and back office from one secure system.</h1>
                        <p>
                            Tijara Suite gives your team one place for POS, inventory, ecommerce,
                            customer management, promotions, reports, and daily operations.
                        </p>
                        <div class="tijara-login-feature-grid" aria-label="Tijara Suite highlights">
                            <div class="tijara-login-feature">
                                <strong>Retail and POS</strong>
                                <span>B2C, B2B, barcode, refunds, discounts, and receipt printing.</span>
                            </div>
                            <div class="tijara-login-feature">
                                <strong>Restaurant and kiosk</strong>
                                <span>Dine-in, takeaway, pickup, queue, menu, and deals screens.</span>
                            </div>
                            <div class="tijara-login-feature">
                                <strong>Inventory control</strong>
                                <span>Stock, expiry, racks, shelves, warehouses, and alerts.</span>
                            </div>
                            <div class="tijara-login-feature">
                                <strong>Pakistan localization</strong>
                                <span>PKR, GST policy, Urdu/English printing, and FBR readiness.</span>
                            </div>
                        </div>
                    </section>
                    <section class="tijara-login-card" aria-label="Sign in">
                        <div class="tijara-login-card-header">
                            <img t-attf-src="/web/binary/company_logo{{ '?dbname='+db if db else '' }}" alt="Business logo"/>
                            <h2>Sign in to <span t-field="res_company.name">Tijara Suite</span></h2>
                            <p>Use your assigned business account to continue.</p>
                        </div>
                        <div class="tijara-login-card-body">
                            <t t-out="0"/>
                        </div>
                        <div class="tijara-login-card-note">
                            For access issues, contact your manager or system administrator.
                        </div>
                    </section>
                </div>
            </t>
        </xpath>
    </template>

    <template id="tijara_web_login_form" inherit_id="web.login" name="Tijara End User Login Form">
        <xpath expr="//form[contains(@t-attf-class, 'oe_login_form')]" position="attributes">
            <attribute name="t-attf-class">oe_login_form</attribute>
        </xpath>
        <xpath expr="//div[.//input[@name='db']]" position="replace">
            <input t-if="request.db" type="hidden" name="db" t-att-value="request.db"/>
        </xpath>
        <xpath expr="//owl-component[@name='web.user_switch']" position="replace"/>
        <xpath expr="//t[@t-call='web.login_oauth']" position="replace"/>
        <xpath expr="//div[hasclass('oe_login_buttons')]/button[@type='submit']" position="replace">
            <button type="submit" class="btn btn-primary">Sign in</button>
        </xpath>
        <xpath expr="//t[@t-if='debug']" position="replace"/>
    </template>
</odoo>
