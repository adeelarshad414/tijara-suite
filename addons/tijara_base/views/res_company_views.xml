<odoo>
    <record id="view_company_form_tijara" model="ir.ui.view">
        <field name="name">res.company.form.tijara</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="tijara_business_type"/>
                <field name="tijara_urdu_name"/>
                <field name="tijara_ntn"/>
                <field name="tijara_strn"/>
                <field name="tijara_branch_code"/>
                <field name="tijara_receipt_language"/>
                <field name="tijara_fbr_pos_enabled"/>
                <field name="tijara_fbr_pos_id"/>
                <field name="tijara_fiscal_device_id"/>
                <field name="tijara_gst_enabled"/>
                <field name="tijara_service_charge_enabled"/>
                <field name="tijara_service_charge_percent"/>
                <field name="tijara_delivery_charge_enabled"/>
                <field name="tijara_delivery_charge_amount"/>
                <field name="tijara_food_payment_tax_enabled"/>
                <field name="tijara_food_card_tax_percent"/>
                <field name="tijara_food_cash_tax_percent"/>
                <field name="tijara_loyalty_enabled"/>
                <field name="tijara_loyalty_points_per_currency"/>
                <separator string="Tenant Branding"/>
                <field name="tijara_brand_primary" placeholder="#1f7a8c"/>
                <field name="tijara_brand_secondary" placeholder="#2d6a4f"/>
                <field name="tijara_brand_accent" placeholder="#d18f1e"/>
                <field name="tijara_brand_tagline"/>
                <field name="tijara_login_headline"/>
                <field name="tijara_login_subtitle"/>
                <field name="tijara_home_headline"/>
                <field name="tijara_home_subtitle"/>
            </xpath>
        </field>
    </record>
</odoo>
