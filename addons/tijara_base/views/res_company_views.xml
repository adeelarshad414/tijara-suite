<odoo>
    <record id="view_company_form_tijara" model="ir.ui.view">
        <field name="name">res.company.form.tijara</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="tijara_business_type"/>
                <field name="tijara_urdu_name"/>
                <field name="tijara_ntn"/>
                <field name="tijara_strn"/>
                <field name="tijara_branch_code"/>
                <field name="tijara_receipt_language"/>
                <field name="tijara_fbr_pos_enabled"/>
                <field name="tijara_fbr_pos_id"/>
                <field name="tijara_fiscal_device_id"/>
            </xpath>
        </field>
    </record>
</odoo>

