<odoo>
    <record id="module_category_tijara" model="ir.module.category">
        <field name="name">Tijara Suite</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_tijara" model="res.groups.privilege">
        <field name="name">Tijara Suite</field>
        <field name="category_id" ref="module_category_tijara"/>
        <field name="sequence">20</field>
    </record>

    <record id="group_tijara_user" model="res.groups">
        <field name="name">Tijara User</field>
        <field name="privilege_id" ref="privilege_tijara"/>
    </record>

    <record id="group_tijara_manager" model="res.groups">
        <field name="name">Tijara Manager</field>
        <field name="privilege_id" ref="privilege_tijara"/>
        <field name="implied_ids" eval="[(4, ref('group_tijara_user'))]"/>
    </record>
</odoo>
