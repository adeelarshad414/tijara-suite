<odoo>
    <record id="action_tijara_fbr_invoice_queue" model="ir.actions.act_window">
        <field name="name">FBR Invoice Queue</field>
        <field name="res_model">tijara.fbr.invoice.queue</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_tijara_fbr_invoice_queue_tree" model="ir.ui.view">
        <field name="name">tijara.fbr.invoice.queue.tree</field>
        <field name="model">tijara.fbr.invoice.queue</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="invoice_ref"/>
                <field name="pos_order_id"/>
                <field name="adapter_provider"/>
                <field name="adapter_mode"/>
                <field name="certification_environment"/>
                <field name="compliance_status"/>
                <field name="submission_attempts"/>
                <field name="fbr_invoice_number"/>
                <field name="submitted_at"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_tijara_fbr_invoice_queue_form" model="ir.ui.view">
        <field name="name">tijara.fbr.invoice.queue.form</field>
        <field name="model">tijara.fbr.invoice.queue</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_queue" type="object" string="Queue" invisible="state != 'draft'"/>
                    <button name="action_submit_to_fbr_adapter" type="object" string="Submit to FBR" invisible="state != 'queued'" groups="tijara_base.group_tijara_manager"/>
                    <button name="action_fail" type="object" string="Mark Failed" invisible="state not in ('queued', 'submitted')" groups="tijara_base.group_tijara_manager"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('submitted', 'cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="invoice_ref"/>
                            <field name="pos_order_id"/>
                            <field name="company_id"/>
                            <field name="adapter_provider"/>
                            <field name="adapter_mode"/>
                            <field name="adapter_endpoint" invisible="adapter_mode != 'live'"/>
                            <field name="adapter_client_id" invisible="adapter_mode != 'live'"/>
                            <field name="certified_provider_name" invisible="adapter_mode != 'live'"/>
                            <field name="provider_credential_reference" invisible="adapter_mode != 'live'"/>
                            <field name="certification_environment"/>
                            <field name="compliance_status"/>
                            <field name="idempotency_key" readonly="1"/>
                        </group>
                        <group>
                            <field name="fbr_invoice_number"/>
                            <field name="provider_invoice_uuid"/>
                            <field name="sandbox_reference"/>
                            <field name="signed_payload_hash"/>
                            <field name="submitted_at"/>
                            <field name="submission_attempts" readonly="1"/>
                            <field name="last_request_at" readonly="1"/>
                            <field name="last_certification_check_at" readonly="1"/>
                            <field name="last_response_status" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="payload"/>
                        <field name="response"/>
                        <field name="qr_payload"/>
                        <field name="error_message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_tijara_fbr_invoice_queue" name="FBR Invoice Queue" parent="tijara_retail_core.menu_tijara_retail" action="action_tijara_fbr_invoice_queue" sequence="40"/>
</odoo>
