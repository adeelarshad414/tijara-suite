<odoo>
    <record id="action_tijara_receipt_profile" model="ir.actions.act_window">
        <field name="name">Invoice and Receipt Templates</field>
        <field name="res_model">tijara.receipt.profile</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_tijara_receipt_profile_tree" model="ir.ui.view">
        <field name="name">tijara.receipt.profile.tree</field>
        <field name="model">tijara.receipt.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="template_scope"/>
                <field name="template_layout"/>
                <field name="company_id"/>
                <field name="language_mode"/>
                <field name="printer_width"/>
                <field name="printer_device_id"/>
                <field name="show_qr"/>
                <field name="show_barcode"/>
                <field name="show_fbr_fields"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_tijara_receipt_profile_form" model="ir.ui.view">
        <field name="name">tijara.receipt.profile.form</field>
        <field name="model">tijara.receipt.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="template_scope"/>
                            <field name="template_layout"/>
                            <field name="company_id"/>
                            <field name="language_mode"/>
                            <field name="printer_width"/>
                            <field name="custom_width_mm" invisible="printer_width != 'custom'"/>
                            <field name="custom_height_mm" invisible="printer_width != 'custom'"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="printer_device_id"/>
                            <field name="show_qr"/>
                            <field name="show_barcode"/>
                            <field name="show_fbr_fields"/>
                            <field name="barcode_source"/>
                            <field name="custom_barcode_value" invisible="barcode_source != 'custom'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content">
                            <group>
                                <field name="receipt_title_english"/>
                                <field name="receipt_title_urdu"/>
                                <field name="header_english"/>
                                <field name="header_urdu"/>
                                <field name="footer_english"/>
                                <field name="footer_urdu"/>
                                <field name="terms_english"/>
                                <field name="terms_urdu"/>
                            </group>
                        </page>
                        <page string="Display Options">
                            <group>
                                <group>
                                    <field name="show_logo"/>
                                    <field name="show_customer"/>
                                    <field name="show_cashier"/>
                                    <field name="show_payment_summary"/>
                                </group>
                                <group>
                                    <field name="show_tax_breakdown"/>
                                    <field name="show_discount_breakdown"/>
                                    <field name="show_company_ntn_strn"/>
                                    <field name="show_return_policy"/>
                                </group>
                            </group>
                        </page>
                        <page string="Custom HTML">
                            <group>
                                <field name="custom_body_html"/>
                                <field name="custom_css"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="internal_notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_tijara_receipt_profile" name="Invoice and Receipt Templates" parent="tijara_retail_core.menu_tijara_retail_configuration" action="action_tijara_receipt_profile" sequence="40"/>
</odoo>
