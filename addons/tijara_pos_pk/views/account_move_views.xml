<odoo>
    <record id="view_move_form_tijara_invoice_template" model="ir.ui.view">
        <field name="name">account.move.form.tijara.invoice.template</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_tijara_print_invoice_template" type="object" string="Tijara Invoice" class="btn-secondary" invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="tijara_invoice_profile_id" invisible="move_type not in ('out_invoice', 'out_refund')"/>
                <field name="tijara_invoice_barcode" readonly="1" invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>
