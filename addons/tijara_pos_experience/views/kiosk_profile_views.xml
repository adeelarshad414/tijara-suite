<odoo>
    <record id="action_tijara_kiosk_profile" model="ir.actions.act_window">
        <field name="name">Kiosk Profiles</field>
        <field name="res_model">tijara.kiosk.profile</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_tijara_kiosk_profile_tree" model="ir.ui.view">
        <field name="name">tijara.kiosk.profile.tree</field>
        <field name="model">tijara.kiosk.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="default_order_type"/>
                <field name="allow_dine_in"/>
                <field name="allow_takeaway"/>
                <field name="allow_pickup"/>
                <field name="allow_delivery"/>
                <field name="allow_b2c"/>
                <field name="allow_b2b"/>
                <field name="auto_create_pos_order"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_tijara_kiosk_profile_form" model="ir.ui.view">
        <field name="name">tijara.kiosk.profile.form</field>
        <field name="model">tijara.kiosk.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="screen_id"/>
                            <field name="default_order_type"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="allow_dine_in"/>
                            <field name="allow_takeaway"/>
                            <field name="allow_pickup"/>
                            <field name="allow_delivery"/>
                            <field name="allow_b2c"/>
                            <field name="allow_b2b"/>
                            <field name="require_customer_for_b2b"/>
                            <field name="require_mobile_for_pickup"/>
                            <field name="auto_create_queue_ticket"/>
                        </group>
                    </group>
                    <group>
                        <field name="allow_cash"/>
                        <field name="allow_card"/>
                        <field name="allow_bank_transfer"/>
                    </group>
                    <group string="POS Sync">
                        <group>
                            <field name="auto_create_pos_order"/>
                            <field name="pos_config_id" invisible="not auto_create_pos_order"/>
                            <field name="payment_capture_mode" invisible="not auto_create_pos_order"/>
                        </group>
                        <group>
                            <field name="cash_payment_method_id" invisible="not auto_create_pos_order"/>
                            <field name="card_payment_method_id" invisible="not auto_create_pos_order"/>
                            <field name="bank_payment_method_id" invisible="not auto_create_pos_order"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_tijara_kiosk_profile" name="Kiosk Profiles" parent="menu_tijara_pos_experience_config" action="action_tijara_kiosk_profile" sequence="10"/>
</odoo>
