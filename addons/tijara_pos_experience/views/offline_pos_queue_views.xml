<odoo>
    <record id="action_tijara_offline_pos_queue" model="ir.actions.act_window">
        <field name="name">Offline POS Queue</field>
        <field name="res_model">tijara.offline.pos.queue</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>

    <record id="action_tijara_offline_pos_review" model="ir.actions.act_window">
        <field name="name">Offline Conflict Review</field>
        <field name="res_model">tijara.offline.pos.queue</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ['failed', 'conflict', 'queued', 'validated'])]</field>
        <field name="context">{'search_default_needs_review': 1}</field>
    </record>

    <record id="action_tijara_offline_pos_audit" model="ir.actions.act_window">
        <field name="name">Offline Replay Audit</field>
        <field name="res_model">tijara.offline.pos.queue</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="context">{'search_default_group_by_state': 1, 'search_default_group_by_source_app': 1}</field>
    </record>

    <record id="view_tijara_offline_pos_queue_search" model="ir.ui.view">
        <field name="name">tijara.offline.pos.queue.search</field>
        <field name="model">tijara.offline.pos.queue</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="order_reference"/>
                <field name="source_device_id"/>
                <field name="source_order_uid"/>
                <field name="pos_config_id"/>
                <filter name="needs_review" string="Needs Review" domain="[('state', 'in', ['failed', 'conflict', 'queued', 'validated'])]"/>
                <filter name="conflicts" string="Conflicts" domain="[('state', '=', 'conflict')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="replayed" string="Replayed" domain="[('state', '=', 'replayed')]"/>
                <filter name="resolved" string="Resolved" domain="[('state', 'in', ['replayed', 'duplicate', 'merged', 'cancelled'])]"/>
                <group>
                    <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_by_source_app" string="Source App" context="{'group_by': 'source_app'}"/>
                    <filter name="group_by_pos_config" string="POS Register" context="{'group_by': 'pos_config_id'}"/>
                    <filter name="group_by_reviewed_by" string="Reviewed By" context="{'group_by': 'reviewed_by_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_tijara_offline_pos_queue_list" model="ir.ui.view">
        <field name="name">tijara.offline.pos.queue.list</field>
        <field name="model">tijara.offline.pos.queue</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'replayed'" decoration-warning="state in ('queued', 'validated')" decoration-danger="state in ('failed', 'conflict')" decoration-muted="state in ('duplicate', 'merged', 'cancelled')">
                <field name="name"/>
                <field name="pos_config_id"/>
                <field name="source_app"/>
                <field name="source_device_id"/>
                <field name="source_order_uid"/>
                <field name="order_reference"/>
                <field name="amount_total"/>
                <field name="payload_line_count"/>
                <field name="payload_payment_count"/>
                <field name="payload_total_delta"/>
                <field name="queued_at"/>
                <field name="replay_attempts"/>
                <field name="review_action"/>
                <field name="reviewed_by_id"/>
                <field name="replayed_pos_order_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_tijara_offline_pos_queue_form" model="ir.ui.view">
        <field name="name">tijara.offline.pos.queue.form</field>
        <field name="model">tijara.offline.pos.queue</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_validate_payload" type="object" string="Validate" class="btn-primary" invisible="state not in ('queued', 'failed', 'conflict')"/>
                    <button name="action_replay_to_pos" type="object" string="Replay to POS" class="btn-primary" invisible="state not in ('queued', 'validated', 'failed')"/>
                    <button name="action_retry_replay" type="object" string="Retry" invisible="state not in ('queued', 'failed', 'cancelled')"/>
                    <button name="action_mark_duplicate" type="object" string="Mark Duplicate" invisible="state not in ('conflict', 'failed')"/>
                    <button name="action_merge_duplicate" type="object" string="Merge" invisible="state not in ('conflict', 'duplicate')"/>
                    <button name="action_mark_replayed" type="object" string="Mark Replayed" invisible="state not in ('validated', 'conflict')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('replayed', 'duplicate', 'merged', 'cancelled')"/>
                    <button name="action_fail" type="object" string="Fail" invisible="state == 'failed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="pos_config_id"/>
                            <field name="source_app"/>
                            <field name="source_device_id"/>
                            <field name="source_order_uid"/>
                            <field name="order_reference"/>
                        </group>
                        <group>
                            <field name="payment_status"/>
                            <field name="amount_total"/>
                            <field name="payload_hash"/>
                            <field name="queued_at"/>
                            <field name="offline_captured_at"/>
                            <field name="validated_at"/>
                            <field name="replay_attempts"/>
                            <field name="replay_latency_minutes"/>
                            <field name="last_replay_at"/>
                            <field name="replayed_at"/>
                            <field name="replayed_pos_order_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Review">
                            <group>
                                <group>
                                    <field name="duplicate_of_queue_id"/>
                                    <field name="merged_into_queue_id"/>
                                    <field name="review_action"/>
                                    <field name="reviewed_by_id"/>
                                    <field name="reviewed_at"/>
                                </group>
                                <group>
                                    <field name="payload_line_count"/>
                                    <field name="payload_payment_count"/>
                                    <field name="payload_total_delta"/>
                                </group>
                            </group>
                            <group>
                                <field name="review_note"/>
                                <field name="error_message"/>
                            </group>
                        </page>
                        <page string="Payload">
                            <field name="payload_json" nolabel="1"/>
                        </page>
                        <page string="Replay Audit">
                            <group>
                                <field name="queued_at"/>
                                <field name="offline_captured_at"/>
                                <field name="validated_at"/>
                                <field name="last_replay_at"/>
                                <field name="replayed_at"/>
                                <field name="replay_attempts"/>
                                <field name="replay_latency_minutes"/>
                                <field name="replayed_pos_order_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tijara_offline_pos_queue_pivot" model="ir.ui.view">
        <field name="name">tijara.offline.pos.queue.pivot</field>
        <field name="model">tijara.offline.pos.queue</field>
        <field name="arch" type="xml">
            <pivot string="Offline Replay Audit">
                <field name="state" type="row"/>
                <field name="source_app" type="col"/>
                <field name="amount_total" type="measure"/>
                <field name="replay_attempts" type="measure"/>
                <field name="payload_line_count" type="measure"/>
                <field name="payload_payment_count" type="measure"/>
                <field name="replay_latency_minutes" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_tijara_offline_pos_queue_graph" model="ir.ui.view">
        <field name="name">tijara.offline.pos.queue.graph</field>
        <field name="model">tijara.offline.pos.queue</field>
        <field name="arch" type="xml">
            <graph string="Offline Replay Audit" type="bar">
                <field name="state"/>
                <field name="source_app"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <menuitem id="menu_tijara_offline_pos_queue" name="Offline POS Queue" parent="menu_tijara_pos_experience" action="action_tijara_offline_pos_queue" sequence="18"/>
    <menuitem id="menu_tijara_offline_pos_review" name="Offline Conflict Review" parent="menu_tijara_pos_experience" action="action_tijara_offline_pos_review" sequence="19"/>
    <menuitem id="menu_tijara_offline_pos_audit" name="Offline Replay Audit" parent="menu_tijara_pos_experience" action="action_tijara_offline_pos_audit" sequence="20"/>
</odoo>
