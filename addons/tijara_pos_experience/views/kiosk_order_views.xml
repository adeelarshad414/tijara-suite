<odoo>
    <record id="action_tijara_kiosk_order" model="ir.actions.act_window">
        <field name="name">Kiosk Orders</field>
        <field name="res_model">tijara.kiosk.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_tijara_kiosk_order_list" model="ir.ui.view">
        <field name="name">tijara.kiosk.order.list</field>
        <field name="model">tijara.kiosk.order</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'completed'" decoration-warning="state in ('submitted', 'preparing', 'ready')" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="order_type"/>
                <field name="audience"/>
                <field name="customer_name"/>
                <field name="customer_mobile"/>
                <field name="amount_total"/>
                <field name="pickup_code"/>
                <field name="queue_ticket_id"/>
                <field name="pos_order_id"/>
                <field name="payment_status"/>
                <field name="submitted_at"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_tijara_kiosk_order_form" model="ir.ui.view">
        <field name="name">tijara.kiosk.order.form</field>
        <field name="model">tijara.kiosk.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_prepare" type="object" string="Preparing" invisible="state not in ('submitted', 'ready')"/>
                    <button name="action_ready" type="object" string="Ready" invisible="state not in ('submitted', 'preparing')"/>
                    <button name="action_complete" type="object" string="Complete" invisible="state not in ('submitted', 'preparing', 'ready')"/>
                    <button name="action_sync_pos_order" type="object" string="Sync POS" invisible="state == 'draft' or pos_order_id"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('completed', 'cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="profile_id"/>
                            <field name="screen_id"/>
                            <field name="company_id"/>
                            <field name="submitted_at"/>
                        </group>
                        <group>
                            <field name="order_type"/>
                            <field name="audience"/>
                            <field name="payment_method"/>
                            <field name="payment_provider"/>
                            <field name="payment_status"/>
                            <field name="payment_reference"/>
                            <field name="payment_terminal_id"/>
                            <field name="pickup_code"/>
                            <field name="queue_ticket_id"/>
                            <field name="amount_total" readonly="1"/>
                        </group>
                    </group>
                    <group string="POS Sync">
                        <field name="pos_config_id"/>
                        <field name="pos_session_id"/>
                        <field name="pos_order_id"/>
                        <field name="pos_payment_method_id"/>
                        <field name="pos_payment_id"/>
                        <field name="pos_synced_at"/>
                        <field name="pos_sync_error"/>
                    </group>
                    <group string="Customer">
                        <field name="partner_id"/>
                        <field name="customer_name"/>
                        <field name="customer_mobile"/>
                        <field name="customer_email"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="display_content_id"/>
                            <field name="product_id"/>
                            <field name="name"/>
                            <field name="quantity"/>
                            <field name="price_unit"/>
                            <field name="price_subtotal" readonly="1"/>
                        </list>
                    </field>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_tijara_kiosk_order" name="Kiosk Orders" parent="menu_tijara_pos_experience" action="action_tijara_kiosk_order" sequence="12"/>
</odoo>
