<odoo noupdate="1">
    <record id="seq_tijara_cash_shift" model="ir.sequence">
        <field name="name">Tijara Cash Shift</field>
        <field name="code">tijara.cash.shift</field>
        <field name="prefix">SHIFT/%(year)s/</field>
        <field name="padding">5</field>
    </record>

    <record id="seq_tijara_exchange_request" model="ir.sequence">
        <field name="name">Tijara Refund and Exchange</field>
        <field name="code">tijara.exchange.request</field>
        <field name="prefix">RET/%(year)s/</field>
        <field name="padding">5</field>
    </record>
</odoo>

