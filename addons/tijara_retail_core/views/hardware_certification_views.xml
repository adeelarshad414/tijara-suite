<odoo>
    <record id="action_tijara_hardware_certification" model="ir.actions.act_window">
        <field name="name">Hardware Certifications</field>
        <field name="res_model">tijara.hardware.certification</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>

    <record id="action_tijara_hardware_certification_check" model="ir.actions.act_window">
        <field name="name">Hardware Execution Checks</field>
        <field name="res_model">tijara.hardware.certification.check</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>

    <record id="view_tijara_hardware_certification_list" model="ir.ui.view">
        <field name="name">tijara.hardware.certification.list</field>
        <field name="model">tijara.hardware.certification</field>
        <field name="arch" type="xml">
            <list decoration-success="result == 'passed'" decoration-danger="result == 'failed'" decoration-warning="result == 'blocked'">
                <field name="name"/>
                <field name="device_id"/>
                <field name="device_type"/>
                <field name="vendor_name"/>
                <field name="model_name"/>
                <field name="observed_serial_number"/>
                <field name="profile_name"/>
                <field name="certification_type"/>
                <field name="check_count"/>
                <field name="passed_check_count"/>
                <field name="tested_at"/>
                <field name="result"/>
            </list>
        </field>
    </record>

    <record id="view_tijara_hardware_certification_form" model="ir.ui.view">
        <field name="name">tijara.hardware.certification.form</field>
        <field name="model">tijara.hardware.certification</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_prepare_execution_checks" type="object" string="Prepare Checks"/>
                    <button name="action_mark_passed" type="object" string="Passed" class="btn-primary"/>
                    <button name="action_mark_failed" type="object" string="Failed"/>
                    <button name="action_mark_blocked" type="object" string="Blocked"/>
                    <button name="action_refresh_evidence_hash" type="object" string="Refresh Evidence Hash"/>
                    <field name="result" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="device_id"/>
                            <field name="profile_name"/>
                            <field name="certification_type"/>
                            <field name="tested_by_id"/>
                            <field name="tested_at"/>
                        </group>
                        <group>
                            <field name="vendor_name"/>
                            <field name="model_name"/>
                            <field name="observed_serial_number"/>
                            <field name="firmware_version"/>
                            <field name="driver_version"/>
                            <field name="driver_name"/>
                            <field name="connection_type"/>
                            <field name="store_location"/>
                            <field name="certification_standard"/>
                            <field name="physical_signature"/>
                            <field name="last_physical_seen_at"/>
                            <field name="next_retest_date"/>
                            <field name="check_count"/>
                            <field name="passed_check_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Checks">
                            <group string="Summary Checks">
                                <field name="receipt_print_ok"/>
                                <field name="label_print_ok"/>
                                <field name="barcode_scan_ok"/>
                                <field name="qr_scan_ok"/>
                                <field name="cash_drawer_ok"/>
                                <field name="scale_read_ok"/>
                                <field name="customer_display_ok"/>
                            </group>
                            <field name="check_ids">
                                <list editable="bottom" decoration-success="result == 'passed'" decoration-danger="result == 'failed'" decoration-warning="result == 'blocked'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="check_code"/>
                                    <field name="operation"/>
                                    <field name="expected_result"/>
                                    <field name="bridge_job_id"/>
                                    <field name="bridge_response_code"/>
                                    <field name="duration_ms"/>
                                    <field name="executed_at"/>
                                    <field name="result"/>
                                </list>
                            </field>
                        </page>
                        <page string="Evidence">
                            <group>
                                <field name="evidence_summary"/>
                                <field name="evidence_json"/>
                                <field name="evidence_attachment_ids" widget="many2many_binary"/>
                                <field name="evidence_hash" readonly="1"/>
                                <field name="notes"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tijara_hardware_certification_pivot" model="ir.ui.view">
        <field name="name">tijara.hardware.certification.pivot</field>
        <field name="model">tijara.hardware.certification</field>
        <field name="arch" type="xml">
            <pivot string="Hardware Certification Results">
                <field name="device_type" type="row"/>
                <field name="result" type="col"/>
                <field name="check_count" type="measure"/>
                <field name="passed_check_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_tijara_hardware_certification_graph" model="ir.ui.view">
        <field name="name">tijara.hardware.certification.graph</field>
        <field name="model">tijara.hardware.certification</field>
        <field name="arch" type="xml">
            <graph string="Hardware Certification Results" type="bar">
                <field name="device_type"/>
                <field name="result"/>
                <field name="check_count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_tijara_hardware_certification_check_list" model="ir.ui.view">
        <field name="name">tijara.hardware.certification.check.list</field>
        <field name="model">tijara.hardware.certification.check</field>
        <field name="arch" type="xml">
            <list decoration-success="result == 'passed'" decoration-danger="result == 'failed'" decoration-warning="result == 'blocked'">
                <field name="certification_id"/>
                <field name="device_id"/>
                <field name="check_code"/>
                <field name="operation"/>
                <field name="bridge_job_id"/>
                <field name="bridge_response_code"/>
                <field name="duration_ms"/>
                <field name="executed_by_id"/>
                <field name="executed_at"/>
                <field name="result"/>
            </list>
        </field>
    </record>

    <record id="view_tijara_hardware_certification_check_form" model="ir.ui.view">
        <field name="name">tijara.hardware.certification.check.form</field>
        <field name="model">tijara.hardware.certification.check</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_run_bridge_check" type="object" string="Run Bridge Check" class="btn-primary"/>
                    <button name="action_mark_passed_manual" type="object" string="Manual Pass"/>
                    <button name="action_mark_blocked" type="object" string="Blocked"/>
                    <field name="result" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="certification_id"/>
                            <field name="device_id"/>
                            <field name="check_code"/>
                            <field name="operation"/>
                        </group>
                        <group>
                            <field name="bridge_job_id"/>
                            <field name="bridge_response_code"/>
                            <field name="duration_ms"/>
                            <field name="executed_by_id"/>
                            <field name="executed_at"/>
                            <field name="evidence_hash"/>
                        </group>
                    </group>
                    <field name="expected_result"/>
                    <field name="observed_result"/>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tijara_hardware_certification_check_pivot" model="ir.ui.view">
        <field name="name">tijara.hardware.certification.check.pivot</field>
        <field name="model">tijara.hardware.certification.check</field>
        <field name="arch" type="xml">
            <pivot string="Hardware Execution Checks">
                <field name="operation" type="row"/>
                <field name="result" type="col"/>
                <field name="duration_ms" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_tijara_hardware_certification_check_graph" model="ir.ui.view">
        <field name="name">tijara.hardware.certification.check.graph</field>
        <field name="model">tijara.hardware.certification.check</field>
        <field name="arch" type="xml">
            <graph string="Hardware Execution Checks" type="bar">
                <field name="operation"/>
                <field name="result"/>
                <field name="duration_ms" type="measure"/>
            </graph>
        </field>
    </record>

    <menuitem id="menu_tijara_hardware_certification" name="Hardware Certifications" parent="menu_tijara_retail_configuration" action="action_tijara_hardware_certification" sequence="25"/>
    <menuitem id="menu_tijara_hardware_certification_check" name="Hardware Execution Checks" parent="menu_tijara_retail_configuration" action="action_tijara_hardware_certification_check" sequence="26"/>
</odoo>
