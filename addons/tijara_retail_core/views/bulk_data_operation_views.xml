<odoo>
    <record id="action_tijara_bulk_data_operation" model="ir.actions.act_window">
        <field name="name">Bulk Import / Export</field>
        <field name="res_model">tijara.bulk.data.operation</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_tijara_bulk_data_operation_tree" model="ir.ui.view">
        <field name="name">tijara.bulk.data.operation.tree</field>
        <field name="model">tijara.bulk.data.operation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="operation_type"/>
                <field name="data_type"/>
                <field name="processed_count"/>
                <field name="error_count"/>
                <field name="company_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_tijara_bulk_data_operation_form" model="ir.ui.view">
        <field name="name">tijara.bulk.data.operation.form</field>
        <field name="model">tijara.bulk.data.operation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_process" type="object" string="Process" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_export_template" type="object" string="Export Template" invisible="state != 'draft'"/>
                    <button name="action_reset" type="object" string="Reset" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="operation_type"/>
                            <field name="data_type"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="processed_count" readonly="1"/>
                            <field name="error_count" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="file_binary" filename="file_name" invisible="operation_type != 'import'"/>
                        <field name="file_name" invisible="1"/>
                        <field name="result_binary" filename="result_file_name" readonly="1"/>
                        <field name="result_file_name" invisible="1"/>
                    </group>
                    <group>
                        <field name="message" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_tijara_bulk_data_operation" name="Bulk Import / Export" parent="menu_tijara_retail" action="action_tijara_bulk_data_operation" sequence="35"/>
</odoo>
