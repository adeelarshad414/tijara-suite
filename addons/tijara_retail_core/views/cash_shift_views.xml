<odoo>
    <record id="action_tijara_cash_shift" model="ir.actions.act_window">
        <field name="name">Cash Shifts</field>
        <field name="res_model">tijara.cash.shift</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_tijara_cash_shift_tree" model="ir.ui.view">
        <field name="name">tijara.cash.shift.tree</field>
        <field name="model">tijara.cash.shift</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="cashier_id"/>
                <field name="opened_at"/>
                <field name="closed_at"/>
                <field name="opening_balance"/>
                <field name="actual_closing_balance"/>
                <field name="variance"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_tijara_cash_shift_form" model="ir.ui.view">
        <field name="name">tijara.cash.shift.form</field>
        <field name="model">tijara.cash.shift</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open" type="object" string="Open" invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Close" invisible="state != 'open'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="cashier_id"/>
                            <field name="company_id"/>
                            <field name="opened_at"/>
                            <field name="closed_at"/>
                        </group>
                        <group>
                            <field name="opening_balance"/>
                            <field name="expected_closing_balance"/>
                            <field name="actual_closing_balance"/>
                            <field name="variance" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_tijara_cash_shift" name="Cash Shifts" parent="menu_tijara_retail" action="action_tijara_cash_shift" sequence="20"/>
</odoo>

