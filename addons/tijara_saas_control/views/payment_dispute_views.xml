<odoo>
    <record id="action_tijara_saas_payment_dispute" model="ir.actions.act_window">
        <field name="name">Refunds and Chargebacks</field>
        <field name="res_model">tijara.saas.payment.dispute</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>

    <record id="view_tijara_saas_payment_dispute_search" model="ir.ui.view">
        <field name="name">tijara.saas.payment.dispute.search</field>
        <field name="model">tijara.saas.payment.dispute</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="provider_reference"/>
                <field name="transaction_id"/>
                <field name="subscription_id"/>
                <filter name="open_cases" string="Open" domain="[('state', 'in', ['open', 'evidence'])]"/>
                <filter name="chargebacks" string="Chargebacks" domain="[('case_type', '=', 'chargeback')]"/>
                <filter name="refunds" string="Refunds" domain="[('case_type', '=', 'refund')]"/>
                <filter name="requires_accounting" string="Requires Accounting" domain="[('accounting_action', '!=', 'none')]"/>
                <group>
                    <filter name="group_by_provider" string="Provider" context="{'group_by': 'provider'}"/>
                    <filter name="group_by_type" string="Type" context="{'group_by': 'case_type'}"/>
                    <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_by_due_date" string="Due Date" context="{'group_by': 'due_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_tijara_saas_payment_dispute_list" model="ir.ui.view">
        <field name="name">tijara.saas.payment.dispute.list</field>
        <field name="model">tijara.saas.payment.dispute</field>
        <field name="arch" type="xml">
            <list decoration-success="state in ('won', 'closed')" decoration-danger="state == 'lost'" decoration-warning="state in ('open', 'evidence', 'refunded')">
                <field name="name"/>
                <field name="case_type"/>
                <field name="provider"/>
                <field name="provider_reference"/>
                <field name="subscription_id"/>
                <field name="amount"/>
                <field name="provider_fee_amount"/>
                <field name="due_date"/>
                <field name="assigned_user_id"/>
                <field name="accounting_action"/>
                <field name="finance_approval_status"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_tijara_saas_payment_dispute_form" model="ir.ui.view">
        <field name="name">tijara.saas.payment.dispute.form</field>
        <field name="model">tijara.saas.payment.dispute</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open" type="object" string="Open" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_submit_evidence" type="object" string="Submit Evidence" invisible="state not in ('open', 'evidence')"/>
                    <button name="action_mark_won" type="object" string="Won" invisible="state not in ('open', 'evidence')"/>
                    <button name="action_mark_lost" type="object" string="Lost" invisible="state not in ('open', 'evidence')"/>
                    <button name="action_mark_refunded" type="object" string="Refunded" invisible="case_type != 'refund' or state not in ('open', 'evidence')"/>
                    <button name="action_generate_accounting_actions" type="object" string="Generate Finance Actions"/>
                    <button name="action_approve_finance_actions" type="object" string="Approve Finance" invisible="finance_approval_status in ('approved', 'not_required')"/>
                    <button name="action_create_draft_accounting_moves" type="object" string="Create Draft Moves" invisible="finance_approval_status != 'approved'"/>
                    <button name="action_refresh_evidence_hash" type="object" string="Refresh Evidence Hash"/>
                    <button name="action_close" type="object" string="Close" invisible="state == 'closed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="case_type"/>
                            <field name="provider"/>
                            <field name="company_id"/>
                            <field name="provider_reference"/>
                            <field name="transaction_id"/>
                            <field name="amount"/>
                            <field name="provider_fee_amount"/>
                        </group>
                        <group>
                            <field name="subscription_id"/>
                            <field name="invoice_id"/>
                            <field name="webhook_event_id"/>
                            <field name="settlement_line_id"/>
                            <field name="assigned_user_id"/>
                            <field name="due_date"/>
                            <field name="opened_at"/>
                            <field name="evidence_submitted_at"/>
                            <field name="resolved_at"/>
                            <field name="accounting_action"/>
                            <field name="finance_approval_status"/>
                            <field name="finance_approved_by_id"/>
                            <field name="finance_approved_at"/>
                            <field name="accounting_action_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Case">
                            <field name="reason"/>
                            <field name="outcome_note"/>
                        </page>
                        <page string="Evidence">
                            <field name="evidence_summary"/>
                            <field name="evidence_json"/>
                            <field name="evidence_attachment_ids" widget="many2many_binary"/>
                            <field name="evidence_hash" readonly="1"/>
                        </page>
                        <page string="Finance Actions">
                            <field name="accounting_action_ids">
                                <list decoration-success="status in ('approved', 'posted')" decoration-danger="status in ('rejected', 'blocked')" decoration-warning="status == 'pending_approval'">
                                    <field name="name"/>
                                    <field name="action_type"/>
                                    <field name="settlement_batch_id"/>
                                    <field name="settlement_line_id"/>
                                    <field name="amount"/>
                                    <field name="status"/>
                                    <field name="approval_user_id"/>
                                    <field name="accounting_move_id"/>
                                    <field name="refund_payment_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tijara_saas_payment_dispute_pivot" model="ir.ui.view">
        <field name="name">tijara.saas.payment.dispute.pivot</field>
        <field name="model">tijara.saas.payment.dispute</field>
        <field name="arch" type="xml">
            <pivot string="Refund and Chargeback Cases">
                <field name="provider" type="row"/>
                <field name="case_type" type="col"/>
                <field name="amount" type="measure"/>
                <field name="provider_fee_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_tijara_saas_payment_dispute_graph" model="ir.ui.view">
        <field name="name">tijara.saas.payment.dispute.graph</field>
        <field name="model">tijara.saas.payment.dispute</field>
        <field name="arch" type="xml">
            <graph string="Refund and Chargeback Cases" type="bar">
                <field name="provider"/>
                <field name="state"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <menuitem id="menu_tijara_saas_payment_dispute" name="Refunds and Chargebacks" parent="menu_tijara_saas" action="action_tijara_saas_payment_dispute" sequence="57"/>
</odoo>
