<odoo>
    <record id="action_tijara_saas_payment_accounting_action" model="ir.actions.act_window">
        <field name="name">Payment Accounting Actions</field>
        <field name="res_model">tijara.saas.payment.accounting.action</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>

    <record id="view_tijara_saas_payment_accounting_action_search" model="ir.ui.view">
        <field name="name">tijara.saas.payment.accounting.action.search</field>
        <field name="model">tijara.saas.payment.accounting.action</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="settlement_batch_id"/>
                <field name="settlement_line_id"/>
                <field name="dispute_case_id"/>
                <field name="subscription_id"/>
                <field name="invoice_id"/>
                <filter name="pending" string="Pending Approval" domain="[('status', '=', 'pending_approval')]"/>
                <filter name="approved" string="Approved" domain="[('status', 'in', ['approved', 'posted'])]"/>
                <filter name="approved_without_move" string="Approved Without Move" domain="[('status', '=', 'approved'), ('accounting_move_id', '=', False)]"/>
                <filter name="blocked" string="Blocked" domain="[('status', 'in', ['blocked', 'rejected'])]"/>
                <group>
                    <filter name="group_by_provider" string="Provider" context="{'group_by': 'provider'}"/>
                    <filter name="group_by_action_type" string="Action Type" context="{'group_by': 'action_type'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_by_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_tijara_saas_payment_accounting_action_list" model="ir.ui.view">
        <field name="name">tijara.saas.payment.accounting.action.list</field>
        <field name="model">tijara.saas.payment.accounting.action</field>
        <field name="arch" type="xml">
            <list decoration-success="status in ('approved', 'posted')" decoration-danger="status in ('rejected', 'blocked')" decoration-warning="status == 'pending_approval'">
                <field name="name"/>
                <field name="action_type"/>
                <field name="provider"/>
                <field name="settlement_batch_id"/>
                <field name="settlement_line_id"/>
                <field name="dispute_case_id"/>
                <field name="subscription_id"/>
                <field name="amount"/>
                <field name="accounting_move_id"/>
                <field name="refund_payment_id"/>
                <field name="requested_at"/>
                <field name="approval_user_id"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_tijara_saas_payment_accounting_action_form" model="ir.ui.view">
        <field name="name">tijara.saas.payment.accounting.action.form</field>
        <field name="model">tijara.saas.payment.accounting.action</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_request_approval" type="object" string="Request Approval" invisible="status != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="status not in ('draft', 'pending_approval')"/>
                    <button name="action_reject" type="object" string="Reject" invisible="status not in ('draft', 'pending_approval')"/>
                    <button name="action_create_draft_accounting_move" type="object" string="Create Draft Move" class="btn-primary" invisible="status != 'approved' or accounting_move_id"/>
                    <button name="action_post_accounting_move" type="object" string="Post Move" invisible="status != 'approved' or not accounting_move_id"/>
                    <button name="action_mark_posted" type="object" string="Mark Posted" invisible="status not in ('approved', 'blocked')"/>
                    <button name="action_mark_blocked" type="object" string="Block" invisible="status in ('posted', 'blocked')"/>
                    <button name="action_refresh_audit_hash" type="object" string="Refresh Hash"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="action_type"/>
                            <field name="provider"/>
                            <field name="company_id"/>
                            <field name="amount"/>
                            <field name="accounting_move_id"/>
                            <field name="refund_payment_id"/>
                            <field name="audit_hash"/>
                        </group>
                        <group>
                            <field name="settlement_batch_id"/>
                            <field name="settlement_line_id"/>
                            <field name="dispute_case_id"/>
                            <field name="webhook_event_id"/>
                            <field name="subscription_id"/>
                            <field name="invoice_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="requested_by_id"/>
                        <field name="requested_at"/>
                        <field name="approval_user_id"/>
                        <field name="approved_at"/>
                        <field name="draft_move_created_by_id"/>
                        <field name="draft_move_created_at"/>
                        <field name="posted_at"/>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                            <field name="rejection_reason"/>
                        </page>
                        <page string="Context">
                            <field name="raw_context_json"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tijara_saas_payment_accounting_action_pivot" model="ir.ui.view">
        <field name="name">tijara.saas.payment.accounting.action.pivot</field>
        <field name="model">tijara.saas.payment.accounting.action</field>
        <field name="arch" type="xml">
            <pivot string="Payment Accounting Actions">
                <field name="action_type" type="row"/>
                <field name="status" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_tijara_saas_payment_accounting_action_graph" model="ir.ui.view">
        <field name="name">tijara.saas.payment.accounting.action.graph</field>
        <field name="model">tijara.saas.payment.accounting.action</field>
        <field name="arch" type="xml">
            <graph string="Payment Accounting Actions" type="bar">
                <field name="action_type"/>
                <field name="status"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <menuitem id="menu_tijara_saas_payment_accounting_action" name="Payment Accounting Actions" parent="menu_tijara_saas" action="action_tijara_saas_payment_accounting_action" sequence="58"/>
</odoo>
