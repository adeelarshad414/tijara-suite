<odoo>
    <record id="action_tijara_saas_plan" model="ir.actions.act_window">
        <field name="name">SaaS Plans</field>
        <field name="res_model">tijara.saas.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_tijara_saas_plan_tree" model="ir.ui.view">
        <field name="name">tijara.saas.plan.tree</field>
        <field name="model">tijara.saas.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="name"/>
                <field name="code"/>
                <field name="monthly_price"/>
                <field name="user_limit"/>
                <field name="branch_limit"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_tijara_saas_plan_form" model="ir.ui.view">
        <field name="name">tijara.saas.plan.form</field>
        <field name="model">tijara.saas.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="monthly_price"/>
                            <field name="annual_price"/>
                            <field name="user_limit"/>
                            <field name="branch_limit"/>
                            <field name="product_limit"/>
                        </group>
                    </group>
                    <field name="feature_ids" widget="many2many_tags"/>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_tijara_saas_plan" name="Plans" parent="menu_tijara_saas" action="action_tijara_saas_plan" sequence="20"/>
</odoo>

