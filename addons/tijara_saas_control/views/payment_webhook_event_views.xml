<odoo>
    <record id="action_tijara_saas_payment_webhook_event" model="ir.actions.act_window">
        <field name="name">Payment Webhooks</field>
        <field name="res_model">tijara.saas.payment.webhook.event</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_tijara_saas_payment_webhook_event_list" model="ir.ui.view">
        <field name="name">tijara.saas.payment.webhook.event.list</field>
        <field name="model">tijara.saas.payment.webhook.event</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'applied'" decoration-danger="status == 'failed'">
                <field name="name"/>
                <field name="provider"/>
                <field name="event_reference"/>
                <field name="transaction_id"/>
                <field name="subscription_id"/>
                <field name="database_name"/>
                <field name="payment_status"/>
                <field name="reconciliation_status"/>
                <field name="amount"/>
                <field name="received_at"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_tijara_saas_payment_webhook_event_form" model="ir.ui.view">
        <field name="name">tijara.saas.payment.webhook.event.form</field>
        <field name="model">tijara.saas.payment.webhook.event</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_apply" type="object" string="Apply Event" class="btn-primary" invisible="status == 'applied'"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="provider"/>
                            <field name="event_reference"/>
                            <field name="provider_reference"/>
                            <field name="transaction_id"/>
                            <field name="settlement_batch"/>
                            <field name="payment_status"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="subscription_id"/>
                            <field name="database_name"/>
                            <field name="invoice_id"/>
                            <field name="company_id"/>
                            <field name="received_at"/>
                            <field name="processed_at"/>
                            <field name="reconciled_at"/>
                        </group>
                    </group>
                    <group>
                        <field name="signature"/>
                        <field name="signature_status"/>
                        <field name="reconciliation_status"/>
                        <field name="error_message"/>
                    </group>
                    <field name="raw_payload"/>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_tijara_saas_payment_webhook_event" name="Payment Webhooks" parent="menu_tijara_saas" action="action_tijara_saas_payment_webhook_event" sequence="50"/>
</odoo>
