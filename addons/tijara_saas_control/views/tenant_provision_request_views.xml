<odoo>
    <record id="action_tijara_tenant_provision_request" model="ir.actions.act_window">
        <field name="name">Tenant Provisioning</field>
        <field name="res_model">tijara.tenant.provision.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_tijara_tenant_provision_request_list" model="ir.ui.view">
        <field name="name">tijara.tenant.provision.request.list</field>
        <field name="model">tijara.tenant.provision.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="tenant_name"/>
                <field name="database_name"/>
                <field name="subscription_id"/>
                <field name="plan_id"/>
                <field name="requested_at"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_tijara_tenant_provision_request_form" model="ir.ui.view">
        <field name="name">tijara.tenant.provision.request.form</field>
        <field name="model">tijara.tenant.provision.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve" invisible="state != 'draft'"/>
                    <button name="action_start_provisioning" type="object" string="Start Provisioning" invisible="state != 'approved'"/>
                    <button name="action_generate_operations_manifest" type="object" string="Generate Ops Manifest" invisible="state not in ('approved', 'provisioning', 'provisioned')"/>
                    <button name="action_mark_provisioned" type="object" string="Mark Provisioned" invisible="state != 'provisioning'"/>
                    <button name="action_fail" type="object" string="Fail" invisible="state not in ('approved', 'provisioning')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('provisioned', 'cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="tenant_name"/>
                            <field name="database_name"/>
                            <field name="subscription_id"/>
                            <field name="plan_id"/>
                            <field name="customer_id"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="requested_by_id"/>
                            <field name="requested_at"/>
                            <field name="approved_at"/>
                            <field name="provisioned_at"/>
                        </group>
                    </group>
                    <group string="Operations Automation">
                        <group>
                            <field name="primary_domain"/>
                            <field name="dns_provider"/>
                            <field name="ingress_class"/>
                        </group>
                        <group>
                            <field name="admin_login"/>
                            <field name="admin_email"/>
                            <field name="backup_policy"/>
                            <field name="monitoring_enabled"/>
                        </group>
                    </group>
                    <group>
                        <field name="provisioning_runbook"/>
                        <field name="operations_manifest"/>
                        <field name="error_message"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_tijara_tenant_provision_request" name="Tenant Provisioning" parent="menu_tijara_saas" action="action_tijara_tenant_provision_request" sequence="40"/>
</odoo>
