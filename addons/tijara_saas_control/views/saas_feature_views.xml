<odoo>
    <record id="action_tijara_saas_feature" model="ir.actions.act_window">
        <field name="name">SaaS Features</field>
        <field name="res_model">tijara.saas.feature</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_tijara_saas_feature_tree" model="ir.ui.view">
        <field name="name">tijara.saas.feature.tree</field>
        <field name="model">tijara.saas.feature</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="name"/>
                <field name="code"/>
                <field name="module_name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_tijara_saas_feature_form" model="ir.ui.view">
        <field name="name">tijara.saas.feature.form</field>
        <field name="model">tijara.saas.feature</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="module_name"/>
                        <field name="active"/>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_tijara_saas_feature" name="Features" parent="menu_tijara_saas" action="action_tijara_saas_feature" sequence="10"/>
</odoo>

