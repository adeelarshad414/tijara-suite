<odoo>
    <record id="action_tijara_restaurant_service_profile" model="ir.actions.act_window">
        <field name="name">Restaurant Service Profiles</field>
        <field name="res_model">tijara.restaurant.service.profile</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_tijara_restaurant_service_profile_tree" model="ir.ui.view">
        <field name="name">tijara.restaurant.service.profile.tree</field>
        <field name="model">tijara.restaurant.service.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="allow_dine_in"/>
                <field name="allow_takeaway"/>
                <field name="allow_pickup"/>
                <field name="default_order_type"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_tijara_restaurant_service_profile_form" model="ir.ui.view">
        <field name="name">tijara.restaurant.service.profile.form</field>
        <field name="model">tijara.restaurant.service.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="default_order_type"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="allow_dine_in"/>
                            <field name="allow_takeaway"/>
                            <field name="allow_pickup"/>
                            <field name="require_table_for_dine_in"/>
                            <field name="require_mobile_for_pickup"/>
                            <field name="print_kitchen_ticket_for_takeaway"/>
                            <field name="print_kitchen_ticket_for_pickup"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_tijara_restaurant_service_profile" name="Service Profiles" parent="menu_tijara_restaurant" action="action_tijara_restaurant_service_profile" sequence="5"/>
</odoo>

