<odoo>
    <record id="action_tijara_restaurant_table" model="ir.actions.act_window">
        <field name="name">Restaurant Tables</field>
        <field name="res_model">tijara.restaurant.table</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_tijara_restaurant_table_tree" model="ir.ui.view">
        <field name="name">tijara.restaurant.table.tree</field>
        <field name="model">tijara.restaurant.table</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="area"/>
                <field name="capacity"/>
                <field name="state"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_tijara_restaurant_table_form" model="ir.ui.view">
        <field name="name">tijara.restaurant.table.form</field>
        <field name="model">tijara.restaurant.table</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="area"/>
                        <field name="capacity"/>
                        <field name="company_id"/>
                        <field name="state"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_tijara_restaurant" name="Restaurant" parent="tijara_base.menu_tijara_root" sequence="50"/>
    <menuitem id="menu_tijara_restaurant_table" name="Tables" parent="menu_tijara_restaurant" action="action_tijara_restaurant_table" sequence="10"/>
</odoo>

