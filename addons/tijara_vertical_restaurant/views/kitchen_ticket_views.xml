<odoo>
    <record id="action_tijara_kitchen_ticket" model="ir.actions.act_window">
        <field name="name">Kitchen Tickets</field>
        <field name="res_model">tijara.kitchen.ticket</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_tijara_kitchen_ticket_tree" model="ir.ui.view">
        <field name="name">tijara.kitchen.ticket.tree</field>
        <field name="model">tijara.kitchen.ticket</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="order_type"/>
                <field name="table_id"/>
                <field name="pos_order_id"/>
                <field name="pickup_code"/>
                <field name="promised_at"/>
                <field name="state"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_tijara_kitchen_ticket_form" model="ir.ui.view">
        <field name="name">tijara.kitchen.ticket.form</field>
        <field name="model">tijara.kitchen.ticket</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send" type="object" string="Send" invisible="state != 'draft'"/>
                    <button name="action_prepare" type="object" string="Prepare" invisible="state != 'sent'"/>
                    <button name="action_ready" type="object" string="Ready" invisible="state != 'preparing'"/>
                    <button name="action_served" type="object" string="Served" invisible="state != 'ready'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('served', 'cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="order_type"/>
                        <field name="table_id"/>
                        <field name="pos_order_id"/>
                        <field name="pickup_code"/>
                        <field name="promised_at"/>
                        <field name="company_id"/>
                    </group>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_tijara_kitchen_ticket" name="Kitchen Tickets" parent="menu_tijara_restaurant" action="action_tijara_kitchen_ticket" sequence="20"/>
</odoo>
