<odoo>
    <record id="product_template_form_view_tijara_garments" model="ir.ui.view">
        <field name="name">product.template.form.tijara.garments</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page name="tijara_garments" string="Garments">
                    <group>
                        <field name="tijara_style_code"/>
                        <field name="tijara_fabric"/>
                        <field name="tijara_season"/>
                        <field name="tijara_size_family"/>
                        <field name="tijara_color_code"/>
                        <field name="tijara_allow_alteration"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
