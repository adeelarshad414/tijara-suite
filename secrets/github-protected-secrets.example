# GitHub environment secrets for the protected Tijara release evidence job.
# Do not store real values in this file. Configure these names under the
# staging/production GitHub Environment "Secrets" tab or through the selected
# secret manager.

ODOO_DATABASE=replace-with-staging-or-production-db
ODOO_USERNAME=replace-with-protected-e2e-user
ODOO_PASSWORD=replace-with-protected-e2e-password

POSTGRES_USER=odoo
POSTGRES_PASSWORD=replace-with-postgres-password
ODOO_DB_PASSWORD=replace-with-odoo-db-password
ODOO_MASTER_PASSWORD=replace-with-odoo-master-password

TIJARA_E2E_LOGIN=replace-with-protected-e2e-user
TIJARA_E2E_PASSWORD=replace-with-protected-e2e-password

TIJARA_BRIDGE_SHARED_SECRET=replace-with-hardware-bridge-secret
TIJARA_PREFLIGHT_ODOO_AUTH_VALUE=replace-with-optional-odoo-probe-header-value
TIJARA_PREFLIGHT_PROMETHEUS_AUTH_VALUE=Bearer replace-with-prometheus-token
TIJARA_PREFLIGHT_ALERTMANAGER_AUTH_VALUE=Bearer replace-with-alertmanager-token
TIJARA_PREFLIGHT_GRAFANA_AUTH_VALUE=Bearer replace-with-grafana-token
TIJARA_PAYMENT_WEBHOOK_SECRET=replace-with-payment-webhook-secret
FBR_CLIENT_SECRET=replace-with-certified-provider-secret

STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
JAZZCASH_INTEGRITY_SECRET=replace-with-jazzcash-secret
EASYPAISA_WEBHOOK_SECRET=replace-with-easypaisa-secret
