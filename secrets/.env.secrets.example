# Central secret configuration. This is the only committed runtime template for
# secret variable names. Copy it to secrets/.env.secrets for local/staging use.
# Never commit the copied file. In production, prefer Vault, Doppler, SOPS,
# Kubernetes Secrets, Docker secrets, or the cloud provider secret manager
# instead of a plain env file. See docs/CONFIGURATION_AND_SECRETS.md.

POSTGRES_PASSWORD=replace-with-long-random-postgres-password
ODOO_DB_PASSWORD=replace-with-same-password-as-postgres-for-single-db-dev
ODOO_MASTER_PASSWORD=replace-with-long-random-odoo-master-password

BACKUP_ENCRYPTION_KEY=replace-with-long-random-backup-encryption-key
ODOO_SESSION_SECRET=replace-with-long-random-session-secret
GRAFANA_ADMIN_PASSWORD=replace-with-long-random-grafana-admin-password
TIJARA_METRICS_TOKEN=dummy-prometheus-token-change-me

FBR_CLIENT_ID=replace-when-fbr-adapter-is-implemented
FBR_CLIENT_SECRET=replace-when-fbr-adapter-is-implemented
PAYMENT_GATEWAY_SECRET=replace-when-payment-adapter-is-implemented
TIJARA_PAYMENT_WEBHOOK_SECRET=replace-with-long-random-payment-webhook-secret
TIJARA_STRIPE_WEBHOOK_SECRET=replace-with-provider-stripe-webhook-secret
TIJARA_JAZZCASH_INTEGRITY_SALT=replace-with-provider-jazzcash-integrity-salt
TIJARA_EASYPAISA_WEBHOOK_SECRET=replace-with-provider-easypaisa-webhook-secret

TIJARA_BRIDGE_SHARED_SECRET=replace-with-long-random-local-bridge-secret

CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token
AWS_ACCESS_KEY_ID=replace-with-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-access-key
AWS_SESSION_TOKEN=replace-with-aws-session-token-if-required
KUBECONFIG=replace-with-protected-kubeconfig-path-or-secret-ref
