# Example OpenMetrics payload for staging runbooks and alert-rule tests.
# The live Odoo exporter remains /tijara/monitoring/metrics.
# These dummy/assumed values can be pushed to Pushgateway with
# `make prometheus-demo-metrics` so Grafana dashboards show representative data.
up{job="tijara-odoo-business",instance="demo-odoo"} 1
probe_success{job="tijara-http-blackbox",instance="http://odoo:8069/web/login"} 1
probe_success{job="tijara-http-blackbox",instance="http://hardware_bridge:9109/health"} 1
probe_duration_seconds{job="tijara-http-blackbox",instance="http://odoo:8069/web/login"} 0.18
probe_duration_seconds{job="tijara-http-blackbox",instance="http://hardware_bridge:9109/health"} 0.07
