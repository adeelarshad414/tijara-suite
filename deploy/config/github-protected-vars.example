# GitHub environment variables for the protected Tijara release evidence job.
# These are non-secret references. Configure them under the staging/production
# GitHub Environment "Variables" tab.

TIJARA_PROTECTED_RELEASE_CHECKS=full
TIJARA_PROTECTED_REQUIRED_EVIDENCE_GROUPS=release,e2e,ops,security
TIJARA_PROTECTED_CERTIFICATION_GROUPS=psp,fbr,hardware
TIJARA_PREFLIGHT_PROBE_URLS=1
TIJARA_PREFLIGHT_REQUIRE_URLS=0
TIJARA_PREFLIGHT_PROBE_TIMEOUT=5
TIJARA_ARTIFACT_STORE_REFERENCE=s3:tijara-release-evidence-production
TIJARA_ARTIFACT_RETENTION_POLICY_REF=policy:release-evidence-365d
TIJARA_CERTIFICATION_RETENTION_POLICY_REF=policy:certification-evidence-365d

TIJARA_SECRET_MANAGER_PROVIDER=vault
TIJARA_SECRET_MANAGER_REFERENCE=vault:tijara/production
TIJARA_SECRET_ROTATION_POLICY_REF=runbook:secret-rotation-quarterly
TIJARA_SECRET_ACCESS_REVIEW_REF=review:production-secret-access-q2

TIJARA_RESTORE_DRILL_BACKUP=deploy/runtime/backups/latest.dump
TIJARA_BACKUP_ARTIFACT_REF=backup:production-latest

ODOO_IMAGE=odoo:19.0
POSTGRES_IMAGE=postgres:16-alpine

TIJARA_BASE_URL=https://staging.example.com
ODOO_BASE_URL=https://staging.example.com
TIJARA_HARDWARE_BRIDGE_URL=https://bridge-staging.example.com
TIJARA_PROMETHEUS_URL=https://prometheus-staging.example.com
TIJARA_ALERTMANAGER_URL=https://alertmanager-staging.example.com
TIJARA_GRAFANA_URL=https://grafana-staging.example.com

TIJARA_E2E_SCOPE=full
TIJARA_RUN_POS_UI_E2E=1
TIJARA_RUN_DIRECT_POS_CLICKTHROUGH=1
TIJARA_RUN_DIRECT_POS_VALIDATE_E2E=1
TIJARA_RUN_DIRECT_REFUND_FORM_E2E=1
TIJARA_RUN_MOBILE_OFFLINE_E2E=1
TIJARA_PROTECTED_E2E_SEED=0
TIJARA_PROTECTED_E2E_PROFILE=1
TIJARA_PROTECTED_E2E_RUN_BROWSER=1
TIJARA_PROTECTED_E2E_EXECUTION_EVIDENCE=1
TIJARA_PROTECTED_E2E_STRICT=1

TIJARA_LOAD_VUS=25
TIJARA_LOAD_DURATION=10m
TIJARA_LOAD_MAX_P95_MS=1000
TIJARA_LOAD_MAX_FAIL_RATE=0.01
TIJARA_LOAD_MIN_CHECKS_RATE=0.95

TIJARA_CERT_PSP_PROVIDER=JazzCash
TIJARA_CERT_PSP_REFERENCE=PSP-CERT-REFERENCE
TIJARA_CERT_PSP_OWNER=FinanceLead
TIJARA_CERT_PSP_EVIDENCE_FILES=/secure/tijara/certification/psp/psp-certification-letter.pdf,/secure/tijara/certification/psp/settlement-sample.csv
TIJARA_CERT_PSP_ARTIFACT_MANIFEST=/secure/tijara/certification/psp/psp-certification-manifest.json
TIJARA_CERT_PSP_EXPECTED_SHA256=/secure/tijara/certification/psp/psp-certification-letter.pdf=replace-with-64-character-sha256,/secure/tijara/certification/psp/settlement-sample.csv=replace-with-64-character-sha256
TIJARA_CERT_PSP_MINIMUM_EVIDENCE_FILES=2
TIJARA_CERT_PSP_APPROVED_BY=FinanceLead
TIJARA_CERT_PSP_APPROVAL_REFERENCE=approval:psp-certification
TIJARA_CERT_PSP_VALID_UNTIL=2027-06-05
TIJARA_CERT_PSP_METADATA=provider_batch=replace-with-provider-batch

TIJARA_CERT_FBR_PROVIDER=CertifiedFBRProvider
TIJARA_CERT_FBR_REFERENCE=FBR-SANDBOX-REFERENCE
TIJARA_CERT_FBR_OWNER=TaxLead
TIJARA_CERT_FBR_EVIDENCE_FILES=/secure/tijara/certification/fbr/provider-certification-letter.pdf,/secure/tijara/certification/fbr/sandbox-accepted-response.json
TIJARA_CERT_FBR_ARTIFACT_MANIFEST=/secure/tijara/certification/fbr/fbr-certification-manifest.json
TIJARA_CERT_FBR_EXPECTED_SHA256=/secure/tijara/certification/fbr/provider-certification-letter.pdf=replace-with-64-character-sha256,/secure/tijara/certification/fbr/sandbox-accepted-response.json=replace-with-64-character-sha256
TIJARA_CERT_FBR_MINIMUM_EVIDENCE_FILES=2
TIJARA_CERT_FBR_APPROVED_BY=TaxLead
TIJARA_CERT_FBR_APPROVAL_REFERENCE=approval:fbr-certification
TIJARA_CERT_FBR_VALID_UNTIL=2027-06-05
TIJARA_CERT_FBR_METADATA=fbr_pos_id=replace-with-pos-id,branch_code=replace-with-branch-code

TIJARA_CERT_HARDWARE_OWNER=OperationsLead
TIJARA_CERT_HARDWARE_STORE=Karachi-Branch
TIJARA_CERT_HARDWARE_DEVICE_MODEL=Epson-TM-T88VI
TIJARA_CERT_HARDWARE_DEVICE_SERIAL=replace-with-device-serial
TIJARA_CERT_HARDWARE_EVIDENCE_FILES=/secure/tijara/certification/hardware/receipt-print-proof.txt
TIJARA_CERT_HARDWARE_ARTIFACT_MANIFEST=/secure/tijara/certification/hardware/hardware-certification-manifest.json
TIJARA_CERT_HARDWARE_EXPECTED_SHA256=/secure/tijara/certification/hardware/receipt-print-proof.txt=replace-with-64-character-sha256
TIJARA_CERT_HARDWARE_MINIMUM_EVIDENCE_FILES=1
TIJARA_CERT_HARDWARE_APPROVED_BY=OperationsLead
TIJARA_CERT_HARDWARE_APPROVAL_REFERENCE=approval:hardware-certification
TIJARA_CERT_HARDWARE_VALID_UNTIL=2027-06-05
TIJARA_CERT_HARDWARE_METADATA=device_type=receipt_printer
