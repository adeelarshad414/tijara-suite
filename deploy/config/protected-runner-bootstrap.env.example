# Tijara protected runner bootstrap config.
# Secret-free defaults for preparing a self-hosted GitHub runner that executes
# strict staging/production release evidence.

: "${TIJARA_BOOTSTRAP_MODE:=dry-run}"
: "${TIJARA_BOOTSTRAP_TARGET_OS:=auto}"
: "${TIJARA_BOOTSTRAP_REQUIRED_TOOLS:=python3,node,npm,docker,docker-compose,trivy,k6,psql,pg_dump,pg_restore}"
: "${TIJARA_BOOTSTRAP_OPTIONAL_TOOLS:=pip-audit,gh}"

# Set this to the operating-system account that runs GitHub Actions jobs.
# On Linux, the install plan adds this user to the docker group.
: "${TIJARA_BOOTSTRAP_DOCKER_GROUP_USER:=github-runner}"

# Keep protected preflight aligned with the bootstrap contract.
: "${TIJARA_PREFLIGHT_CHECK_TOOLS:=1}"
: "${TIJARA_PREFLIGHT_REQUIRED_TOOLS:=python3,node,npm,docker,docker-compose,trivy,k6,psql,pg_dump,pg_restore}"
: "${TIJARA_PREFLIGHT_OPTIONAL_TOOLS:=pip-audit,gh}"
: "${TIJARA_PREFLIGHT_TOOL_TIMEOUT:=8}"
