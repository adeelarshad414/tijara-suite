{
  "metadata": {
    "description": "Full Tijara production infra template using AWS Route53 DNS, cert-manager TLS, and PostgreSQL backup/restore runners.",
    "provider_stack": [
      "route53",
      "cert-manager",
      "postgres"
    ]
  },
  "command_templates": {
    "dns_apply_command_template": "bash deploy/production-infra/runners/route53-dns.sh apply --hosted-zone-id-env ROUTE53_HOSTED_ZONE_ID --hostname {domain} --target {dns_target} --record-type {record_type} --ttl {ttl}",
    "dns_rollback_command_template": "bash deploy/production-infra/runners/route53-dns.sh rollback --hosted-zone-id-env ROUTE53_HOSTED_ZONE_ID --hostname {domain} --record-type {record_type} --previous-target-env ROUTE53_PREVIOUS_TARGET",
    "tls_apply_command_template": "bash deploy/production-infra/runners/cert-manager-tls.sh apply --namespace {namespace} --domain {domain} --tls-secret {tls_secret} --issuer {tls_issuer}",
    "tls_rollback_command_template": "bash deploy/production-infra/runners/cert-manager-tls.sh rollback --namespace {namespace} --domain {domain} --tls-secret {tls_secret}",
    "backup_command_template": "bash deploy/production-infra/runners/postgres-backup-runner.sh backup --database {backup_database} --retention-days {backup_retention_days}",
    "restore_drill_command_template": "bash deploy/production-infra/runners/postgres-backup-runner.sh restore-drill --database {backup_database} --backup-ref {restore_drill_ref}"
  }
}
