{
  "metadata": {
    "description": "Cloudflare DNS apply and rollback templates for Tijara tenant domains.",
    "provider": "cloudflare",
    "secrets": [
      "CLOUDFLARE_API_TOKEN"
    ],
    "variables": [
      "CLOUDFLARE_ZONE_ID",
      "CLOUDFLARE_RECORD_ID"
    ]
  },
  "command_templates": {
    "dns_apply_command_template": "bash deploy/production-infra/runners/cloudflare-dns.sh apply --zone-id-env CLOUDFLARE_ZONE_ID --token-env CLOUDFLARE_API_TOKEN --hostname {domain} --target {dns_target} --record-type {record_type} --ttl {ttl}",
    "dns_rollback_command_template": "bash deploy/production-infra/runners/cloudflare-dns.sh rollback --zone-id-env CLOUDFLARE_ZONE_ID --token-env CLOUDFLARE_API_TOKEN --hostname {domain} --record-id-env CLOUDFLARE_RECORD_ID"
  }
}
