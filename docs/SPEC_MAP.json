{
  "app": {
    "name": "Tijara Suite",
    "package_name": "tijara-suite",
    "version": "0.18.0",
    "type": "Odoo Community SaaS web application",
    "license": "LGPL-3.0-or-later",
    "market": "Pakistan retail, restaurant, wholesale, and back-office operations"
  },
  "base_urls": {
    "web": "http://localhost:8069",
    "longpolling": "http://localhost:8072",
    "hardware_bridge": "http://localhost:9109",
    "prometheus": "http://localhost:9090",
    "grafana": "http://localhost:3000"
  },
  "services": [
    {
      "name": "odoo",
      "runtime": "Docker Compose service",
      "port": 8069,
      "health_url": "/web/login",
      "required": true
    },
    {
      "name": "postgres",
      "runtime": "Docker Compose service",
      "port": 5432,
      "required": true
    },
    {
      "name": "hardware_bridge",
      "runtime": "Docker Compose hardware profile",
      "port": 9109,
      "required": false
    },
    {
      "name": "prometheus",
      "runtime": "Docker Compose monitoring profile",
      "port": 9090,
      "required": false
    },
    {
      "name": "grafana",
      "runtime": "Docker Compose monitoring profile",
      "port": 3000,
      "required": false
    }
  ],
  "personas": [
    {
      "role": "platform_superadmin",
      "email": "superadmin@demo.tijara-suite.local",
      "permissions": [
        "platform operations",
        "tenant provisioning",
        "SaaS plans",
        "release evidence",
        "protected runner sign-off"
      ],
      "key_workflows": [
        "Create SaaS plan",
        "Provision tenant",
        "Review protected release artifacts",
        "Run production readiness gates"
      ]
    },
    {
      "role": "tenant_admin",
      "email": "tenant-admin@demo.tijara-suite.local",
      "permissions": [
        "Tijara Manager",
        "business configuration",
        "feature flags",
        "staff setup",
        "reports"
      ],
      "key_workflows": [
        "Configure POS and receipt templates",
        "Enable queue or customer display",
        "Review analytics dashboards",
        "Approve refunds and discounts"
      ]
    },
    {
      "role": "cashier",
      "email": "cashier@demo.tijara-suite.local",
      "permissions": [
        "POS checkout",
        "refund scanning",
        "receipt print",
        "offline queue submission"
      ],
      "key_workflows": [
        "B2C sale",
        "B2B sale",
        "Bill discount",
        "Refund barcode scan",
        "Offline capture and replay"
      ]
    },
    {
      "role": "inventory_manager",
      "email": "inventory-manager@demo.tijara-suite.local",
      "permissions": [
        "product maintenance",
        "stock positions",
        "expiry and low-stock alerts",
        "bulk import export"
      ],
      "key_workflows": [
        "Import products",
        "Review low stock",
        "Assign racks shelves bins",
        "Resolve expiry alerts"
      ]
    },
    {
      "role": "accountant",
      "email": "accountant@demo.tijara-suite.local",
      "permissions": [
        "settlement review",
        "refund and chargeback cases",
        "draft moves",
        "FBR queue review"
      ],
      "key_workflows": [
        "Reconcile PSP settlement",
        "Review chargeback",
        "Create draft finance move",
        "Approve FBR queue evidence"
      ]
    },
    {
      "role": "expense_manager",
      "email": "expense-manager@demo.tijara-suite.local",
      "permissions": [
        "back-office expenses",
        "expense approvals",
        "paid unpaid evidence",
        "petty cash review"
      ],
      "key_workflows": [
        "Submit expense",
        "Approve expense",
        "Mark expense paid",
        "Export expense audit"
      ]
    },
    {
      "role": "salary_manager",
      "email": "salary-manager@demo.tijara-suite.local",
      "permissions": [
        "salary batches",
        "deductions",
        "bonuses",
        "payroll approval"
      ],
      "key_workflows": [
        "Review salary batch",
        "Approve payroll",
        "Mark salaries paid",
        "Audit monthly payroll"
      ]
    },
    {
      "role": "loyalty_manager",
      "email": "loyalty-manager@demo.tijara-suite.local",
      "permissions": [
        "customer details",
        "walk-in conversion",
        "B2B B2C customers",
        "loyalty tiers and points"
      ],
      "key_workflows": [
        "Review loyalty customer",
        "Update tier",
        "Check customer history",
        "Validate POS point accrual"
      ]
    },
    {
      "role": "vertical_manager",
      "email": "vertical-manager@demo.tijara-suite.local",
      "permissions": [
        "vertical catalog",
        "B2B B2C prices",
        "stock policy",
        "business policy settings"
      ],
      "key_workflows": [
        "Review vertical tags",
        "Configure GST service delivery rules",
        "Update B2B B2C price",
        "Check inventory readiness"
      ]
    },
    {
      "role": "promotion_manager",
      "email": "promotion-manager@demo.tijara-suite.local",
      "permissions": [
        "promotions",
        "menu and deals boards",
        "customer display",
        "queue display"
      ],
      "key_workflows": [
        "Publish promotion",
        "Review menu board",
        "Review deals board",
        "Check queue display"
      ]
    },
    {
      "role": "ecommerce_manager",
      "email": "ecommerce-manager@demo.tijara-suite.local",
      "permissions": [
        "storefront channels",
        "online catalog publishing",
        "B2B B2C ecommerce pricing",
        "pickup delivery order review",
        "ecommerce reports"
      ],
      "key_workflows": [
        "Configure ecommerce channel",
        "Publish online products",
        "Validate B2B B2C storefront pricing",
        "Review online sale orders",
        "Hand off pickup delivery orders to queue"
      ]
    },
    {
      "role": "analytics_manager",
      "email": "analytics-manager@demo.tijara-suite.local",
      "permissions": [
        "dashboards",
        "reports",
        "trends",
        "KPI audit"
      ],
      "key_workflows": [
        "Review dashboard catalog",
        "Check KPI snapshots",
        "Review vertical mix",
        "Export audit report"
      ]
    },
    {
      "role": "restaurant_operator",
      "email": "restaurant@demo.tijara-suite.local",
      "permissions": [
        "kiosk orders",
        "queue tickets",
        "kitchen tickets",
        "dine-in takeaway pickup"
      ],
      "key_workflows": [
        "Accept kiosk order",
        "Advance queue ticket",
        "Manage kitchen status",
        "Operate menu board"
      ]
    },
    {
      "role": "public_display",
      "email": "public-display@demo.tijara-suite.local",
      "permissions": [
        "public display route smoke checks",
        "kiosk display checks",
        "menu deals queue display checks"
      ],
      "key_workflows": [
        "Open kiosk route",
        "Open menu board",
        "Open deals board",
        "Open customer display",
        "Open queue display"
      ]
    }
  ],
  "screen_inventory": [
    {
      "name": "Odoo Login",
      "route_path": "/web/login",
      "auth": "public",
      "personas": [],
      "description": "Odoo authentication entry point."
    },
    {
      "name": "Odoo App Shell",
      "route_path": "/odoo",
      "auth": "authenticated",
      "personas": [
        "platform_superadmin",
        "tenant_admin",
        "cashier",
        "inventory_manager",
        "accountant",
        "expense_manager",
        "salary_manager",
        "loyalty_manager",
        "vertical_manager",
        "promotion_manager",
        "ecommerce_manager",
        "analytics_manager",
        "restaurant_operator",
        "public_display"
      ],
      "description": "Authenticated Odoo web app shell for backend modules and POS access."
    },
    {
      "name": "Kiosk Display",
      "route_path": "/tijara/display/tijara-demo-kiosk",
      "auth": "public",
      "personas": [
        "restaurant_operator",
        "promotion_manager",
        "public_display"
      ],
      "description": "Self-ordering kiosk route backed by display screen slug."
    },
    {
      "name": "Kiosk Checkout API",
      "route_path": "/tijara/display/tijara-demo-kiosk/checkout",
      "auth": "public",
      "personas": [
        "restaurant_operator",
        "promotion_manager",
        "public_display"
      ],
      "description": "JSON endpoint for kiosk cart checkout."
    },
    {
      "name": "Menu Board",
      "route_path": "/tijara/display/tijara-demo-menu-board",
      "auth": "public",
      "personas": [
        "restaurant_operator",
        "promotion_manager",
        "public_display"
      ],
      "description": "Public menu board route for restaurants and bakeries."
    },
    {
      "name": "Deals Board",
      "route_path": "/tijara/display/tijara-demo-deals-board",
      "auth": "public",
      "personas": [
        "tenant_admin",
        "restaurant_operator",
        "promotion_manager",
        "public_display"
      ],
      "description": "Public deals and promotions display."
    },
    {
      "name": "Customer Display",
      "route_path": "/tijara/display/tijara-demo-customer-display",
      "auth": "public",
      "personas": [
        "cashier",
        "tenant_admin",
        "promotion_manager",
        "public_display"
      ],
      "description": "Customer-facing live cart and totals display."
    },
    {
      "name": "Queue Display",
      "route_path": "/tijara/display/tijara-demo-queue-display",
      "auth": "public",
      "personas": [
        "restaurant_operator",
        "tenant_admin",
        "promotion_manager",
        "public_display"
      ],
      "description": "Public queue number and pickup status display."
    },
    {
      "name": "Ecommerce Storefront",
      "route_path": "/tijara/ecommerce/tijara-demo-web",
      "auth": "public",
      "personas": [
        "ecommerce_manager",
        "tenant_admin"
      ],
      "description": "Public online storefront route for catalog browsing and checkout."
    },
    {
      "name": "Ecommerce Catalog API",
      "route_path": "/tijara/ecommerce/tijara-demo-web/catalog",
      "auth": "public_json",
      "personas": [
        "ecommerce_manager",
        "analytics_manager"
      ],
      "description": "B2C/B2B catalog, stock, promotions, and Urdu/English product payload endpoint."
    },
    {
      "name": "Ecommerce Checkout API",
      "route_path": "/tijara/ecommerce/tijara-demo-web/checkout",
      "auth": "public_json",
      "personas": [
        "ecommerce_manager",
        "restaurant_operator",
        "tenant_admin"
      ],
      "description": "Online checkout endpoint that creates Odoo sale orders and queue handoff."
    },
    {
      "name": "Ecommerce Tracking",
      "route_path": "/tijara/ecommerce/tijara-demo-web/track",
      "auth": "public",
      "personas": [
        "ecommerce_manager",
        "public_display",
        "tenant_admin"
      ],
      "description": "Customer order tracking route for pickup-code/mobile lookup or private token links."
    },
    {
      "name": "Ecommerce Tracking API",
      "route_path": "/tijara/ecommerce/tijara-demo-web/track/status",
      "auth": "public_json",
      "personas": [
        "ecommerce_manager",
        "analytics_manager",
        "tenant_admin"
      ],
      "description": "Customer-safe order, queue, payment, delivery provider, and tracking payload endpoint."
    },
    {
      "name": "Expense Management",
      "route_path": "/web#model=tijara.expense.request&view_type=list",
      "auth": "authenticated",
      "personas": [
        "expense_manager",
        "tenant_admin",
        "accountant"
      ],
      "description": "Back-office expense submission, approval, payment, and audit screen."
    },
    {
      "name": "Salary Management",
      "route_path": "/web#model=tijara.salary.batch&view_type=list",
      "auth": "authenticated",
      "personas": [
        "salary_manager",
        "tenant_admin",
        "accountant"
      ],
      "description": "Salary batch, deduction, bonus, approval, and payment evidence screen."
    },
    {
      "name": "Loyalty Customer Records",
      "route_path": "/web#model=res.partner&view_type=list",
      "auth": "authenticated",
      "personas": [
        "loyalty_manager",
        "tenant_admin",
        "analytics_manager"
      ],
      "description": "Customer details, walk-in conversion, B2B/B2C type, loyalty tier, and points records."
    },
    {
      "name": "Business Policy Settings",
      "route_path": "/web#model=res.company&view_type=list",
      "auth": "authenticated",
      "personas": [
        "vertical_manager",
        "tenant_admin"
      ],
      "description": "GST, service charge, delivery charge, cafe/restaurant card/cash tax, FBR, and loyalty policy settings."
    },
    {
      "name": "Kiosk Orders",
      "route_path": "/web#model=tijara.kiosk.order&view_type=list",
      "auth": "authenticated",
      "personas": [
        "restaurant_operator",
        "tenant_admin",
        "analytics_manager"
      ],
      "description": "Kiosk dine-in, takeaway, pickup, delivery, customer details, payment status, and POS sync review."
    },
    {
      "name": "Promotions Management",
      "route_path": "/web#model=tijara.promotion&view_type=list",
      "auth": "authenticated",
      "personas": [
        "promotion_manager",
        "tenant_admin"
      ],
      "description": "Promotion, deal, menu-board, and display-board campaign management."
    },
    {
      "name": "Analytics Dashboards",
      "route_path": "/web#model=tijara.analytics.dashboard&view_type=list",
      "auth": "authenticated",
      "personas": [
        "analytics_manager",
        "tenant_admin",
        "platform_superadmin"
      ],
      "description": "Role-based dashboard catalog for owner, POS, inventory, back office, restaurant, loyalty, and vertical analytics."
    },
    {
      "name": "KPI History",
      "route_path": "/web#model=tijara.analytics.snapshot&view_type=list",
      "auth": "authenticated",
      "personas": [
        "analytics_manager",
        "tenant_admin",
        "platform_superadmin"
      ],
      "description": "Daily KPI collector history for sales, inventory, expenses, salaries, loyalty, vertical, queue, and tax policy metrics."
    },
    {
      "name": "Payment Webhook",
      "route_path": "/tijara/saas/payment/webhook/generic",
      "auth": "signed_public",
      "personas": [
        "accountant",
        "platform_superadmin"
      ],
      "description": "Provider payment webhook endpoint requiring shared and native signatures."
    }
  ],
  "feature_inventory": [
    "B2B and B2C POS price handling",
    "Bill-level percentage and amount discount synchronization",
    "Refund and exchange workflows with invoice barcode scanning",
    "Receipt and invoice template customization",
    "Back-office expense and salary management",
    "Customer details and loyalty programs",
    "Cafe-only service charges and cafe/restaurant card cash tax policy",
    "Delivery charges for enabled business types",
    "CSV import export for operational data",
    "Hardware bridge for printers scanners drawers scales labels and customer displays",
    "Kiosk menu deals promotion queue and customer-display public routes",
    "Ecommerce storefront catalog checkout sale-order sync pickup delivery queue handoff customer tracking dry-run delivery provider assignment and ecommerce analytics templates",
    "Offline POS capture replay and conflict review",
    "SaaS feature flags for B2B queue promotion display and customer display",
    "Tenant database provisioning and operations manifests",
    "Subscription billing payment webhooks settlements dunning and suspension",
    "FBR adapter queue and provider readiness evidence",
    "Inventory low-stock expiry rack shelf bin and warehouse intelligence",
    "Analytics dashboards reports trends and daily KPI collectors",
    "Protected release evidence gates and production readiness reports"
  ],
  "verticals": [
    "superstore",
    "grocery",
    "cosmetics",
    "bakery",
    "cloth",
    "pharmacy",
    "cafe",
    "fast_food",
    "restaurant",
    "garments",
    "uniform",
    "shoes",
    "mobile_shop",
    "electronics",
    "wholesale"
  ],
  "environment_variables": {
    "non_secret": [
      "COMPOSE_PROJECT_NAME",
      "TIJARA_ENV",
      "TIJARA_PUBLIC_URL",
      "ODOO_IMAGE",
      "POSTGRES_IMAGE",
      "POSTGRES_DB",
      "POSTGRES_USER",
      "ODOO_DB_HOST",
      "ODOO_DB_PORT",
      "ODOO_DB_USER",
      "HTTP_PORT",
      "LONGPOLLING_PORT",
      "TIJARA_BRIDGE_PORT",
      "TIJARA_SAAS_ENFORCEMENT_ENABLED",
      "TIJARA_PAYMENT_REQUIRE_NATIVE_SIGNATURES",
      "FBR_ADAPTER_MODE",
      "PROMETHEUS_PORT",
      "GRAFANA_PORT"
    ],
    "secret": [
      "POSTGRES_PASSWORD",
      "ODOO_DB_PASSWORD",
      "ODOO_MASTER_PASSWORD",
      "BACKUP_ENCRYPTION_KEY",
      "ODOO_SESSION_SECRET",
      "GRAFANA_ADMIN_PASSWORD",
      "FBR_CLIENT_SECRET",
      "PAYMENT_GATEWAY_SECRET",
      "TIJARA_PAYMENT_WEBHOOK_SECRET",
      "TIJARA_BRIDGE_SHARED_SECRET"
    ]
  },
  "demo_data": {
    "module": "tijara_demo_pos",
    "seed_command": "make seed-pos-demo",
    "notes": "Seeds POS config, open session, vertical demo products, B2B and B2C customers, loyalty records, screens, kiosk profile, queue ticket, promotions, ecommerce storefront channel, published online products, invoice and receipt templates, back-office expenses, and salary batch data. Demo login users must be created or mapped in staging before authenticated E2E."
  },
  "commands": {
    "start": "bash scripts/dev-start.sh",
    "stop": "bash scripts/dev-stop.sh",
    "restart": "bash scripts/dev-restart.sh",
    "validate": "make validate",
    "install_suite": "make install-suite",
    "seed_pos_demo": "make seed-pos-demo",
    "screenshots": "node scripts/capture-screenshots.js",
    "record_demo": "node scripts/record-demo.js",
    "assemble_video": "bash scripts/assemble-video.sh"
  }
}
